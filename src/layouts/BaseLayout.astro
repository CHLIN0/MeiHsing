---
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageType?: string;
  ogType?: 'website' | 'article';
  includeReviewSchema?: boolean;
  structuredData?: Record<string, unknown>[];
  robots?: string;
}

import '../styles/global.css';

// Local fonts via Fontsource. CJK families use one variable file per Unicode
// subset instead of repeating every subset for each individual weight.
import '@fontsource/cormorant/300.css';
import '@fontsource/cormorant/400.css';
import '@fontsource/cormorant/500.css';
import '@fontsource/cormorant/600.css';
import '@fontsource/cormorant/700.css';
import '@fontsource/cormorant/300-italic.css';
import '@fontsource/cormorant/400-italic.css';

import '@fontsource/montserrat/300.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';

import '@fontsource-variable/noto-sans-tc/wght.css';
import '@fontsource-variable/noto-serif-tc/wght.css';

const siteDescription = '林美杏老師——鋼琴教師與音樂教育工作者。逾四十年音樂教育深耕，曾任 YAMAHA 資深講師，現投入鋼琴教學、合唱指導、樂齡音樂輔療與醫院音樂志工服務。';

const {
  title,
  description = siteDescription,
  ogImage = '/logo.webp',
  ogImageAlt = '林美杏音樂教室',
  ogImageWidth,
  ogImageHeight,
  ogImageType,
  ogType = 'website',
  includeReviewSchema = true,
  structuredData = [],
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
} = Astro.props;

const siteUrl = 'https://ms.linho.me';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

// Person schema (enriched)
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteUrl}/#person`,
  "name": "林美杏",
  "alternateName": "Mei-Hsing Lin",
  "jobTitle": "鋼琴教師、音樂教育工作者",
  "description": siteDescription,
  "url": siteUrl,
  "image": `${siteUrl}/head.webp`,
  "sameAs": [
    "https://www.facebook.com/piano.lin.3",
    "https://www.instagram.com/meishing888/",
    "https://www.youtube.com/@%E6%9E%97%E7%BE%8E%E6%9D%8F-w2d"
  ],
  "knowsAbout": ["鋼琴", "音樂教育", "合唱指揮", "YAMAHA 音樂系統", "古典鋼琴", "爵士鋼琴", "自彈自唱", "樂理教學", "樂齡音樂教育", "音樂輔療", "醫院音樂志工服務"],
  "hasCredential": [
    { "@type": "EducationalOccupationalCredential", "name": "YAMAHA 鋼琴教師資格" },
    { "@type": "EducationalOccupationalCredential", "name": "YAMAHA 電子琴教師資格" },
  ],
  "hasOccupation": {
    "@type": "Occupation",
    "name": "鋼琴教師",
    "occupationLocation": { "@type": "City", "name": "高雄市" },
    "description": "鋼琴教學、合唱團指揮與伴奏、樂齡音樂輔療、醫院音樂志工服務",
    "skills": "古典鋼琴, 爵士鋼琴, 自彈自唱, 樂理教學, 合唱指揮, 樂齡音樂",
  },
};

// WebSite schema
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "url": siteUrl,
  "name": "林美杏老師 | 鋼琴教師 · 音樂教育工作者",
  "description": siteDescription,
  "publisher": { "@id": `${siteUrl}/#person` },
  "inLanguage": "zh-Hant",
};

// EducationalOrganization schema
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "@id": `${siteUrl}/#org`,
  "name": "林美杏音樂教室",
  "description": "提供古典鋼琴、爵士鋼琴、自彈自唱及樂理教學，適合兒童、青少年及樂齡學員。",
  "url": siteUrl,
  "founder": { "@id": `${siteUrl}/#person` },
  "areaServed": { "@type": "City", "name": "高雄市" },
  "knowsAbout": ["鋼琴教學", "音樂啟蒙", "合唱指導", "樂齡音樂"],
};

// Review/Testimonial schema
const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "name": "林美杏音樂教室",
  "review": [
    {
      "@type": "Review",
      "reviewBody": "美杏老師讓我家孩子從討厭練琴，變成每天主動坐在鋼琴前。她那種溫柔但堅定的教學方式，真的很神奇。",
      "author": { "@type": "Person", "name": "王媽媽" },
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
    },
    {
      "@type": "Review",
      "reviewBody": "跟美杏老師學了三年，她不只教琴，更教我如何用音樂表達自己。每堂課都像在說一個新故事。",
      "author": { "@type": "Person", "name": "陳同學" },
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
    },
    {
      "@type": "Review",
      "reviewBody": "退休後加入樂齡班，美杏老師的課程讓我重新找到生活的樂趣。音樂真的不分年齡！",
      "author": { "@type": "Person", "name": "林伯伯" },
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
    },
    {
      "@type": "Review",
      "reviewBody": "美杏老師帶領合唱團三十年，她對音樂的熱情感染了每一個團員。我們不只是在唱歌，更是在分享快樂。",
      "author": { "@type": "Person", "name": "張團員" },
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
    },
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5",
    "bestRating": "5",
    "ratingCount": "4",
  },
};
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="林美杏" />
    <meta name="robots" content={robots} />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    {ogImageType && <meta property="og:image:type" content={ogImageType} />}
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content="林美杏老師 | 鋼琴教師 · 音樂教育工作者" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Preconnect (removed Google Fonts, now using self-hosted Fontsource) -->
    <link rel="preconnect" href="https://www.youtube.com" />

    <!-- Favicon -->
    <link rel="icon" type="image/webp" href="/logo.webp" />

    <title>{title}</title>

    <!-- JSON-LD Structured Data: Person -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <!-- JSON-LD Structured Data: WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <!-- JSON-LD Structured Data: EducationalOrganization -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

    <!-- JSON-LD Structured Data: Reviews -->
    {includeReviewSchema && <script type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />}

    {structuredData.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="bg-paper text-warm-700 font-sans">
    <a href="#main-content" class="skip-to-content">跳至主要內容</a>
    <slot />
  </body>
</html>
