---
import lyricsText from '../../data/concert-2026-lyrics.txt?raw';
import {
    concert2026GuideVocal,
    concert2026Instrumental,
    concert2026LyricStartTimes,
} from '../../data/concert-2026-lyrics-timing';
import '../../styles/concert-lyrics-guide.css';

const stanzaMeta = [
    { label: '第一段' },
    { label: '第二段' },
    { label: '副歌', chorus: true },
    { label: '第三段' },
    { label: '最後副歌', chorus: true, finale: true },
] as const;

const stanzas = lyricsText.trim().split(/\n\s*\n/).map((stanza, index) => ({
    ...stanzaMeta[index],
    lines: stanza.split('\n').map((line) => line.trim()).filter(Boolean),
}));

const lineCount = stanzas.reduce((total, stanza) => total + stanza.lines.length, 0);
if (stanzas.length !== 5 || lineCount !== 40) {
    throw new Error(`2026 concert lyrics must contain 5 stanzas and 40 lines; received ${stanzas.length} stanzas and ${lineCount} lines.`);
}

if (
    concert2026LyricStartTimes.length !== lineCount
    || concert2026LyricStartTimes.some((time, index) => index > 0 && time <= concert2026LyricStartTimes[index - 1])
) {
    throw new Error('2026 concert lyric timing must contain one monotonically increasing timestamp per lyric line.');
}

let lyricLineIndex = 0;
---

<section
    id="lyrics"
    class="concert-lyrics"
    aria-labelledby="lyrics-heading"
    data-lyrics-end={concert2026Instrumental.lyricsEnd}
>
    <div class="concert-programme__layout concert-lyrics__layout">
        <header class="concert-lyrics__masthead">
            <h2 id="lyrics-heading">大合唱</h2>
            <p>明天會更好</p>
            <a class="concert-lyrics__projection-link" href="/concert/2026/singalong/">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="13" rx="2"></rect>
                    <path d="M8 21h8M12 17v4"></path>
                </svg>
                <span>開啟投影模式</span>
            </a>
        </header>

        <div class="concert-lyrics__sheet">
            <div class="concert-lyrics__verses">
                {stanzas.map((stanza) => (
                    <section class:list={[
                        'concert-lyrics__stanza',
                        stanza.chorus && 'concert-lyrics__stanza--chorus',
                        stanza.finale && 'concert-lyrics__stanza--finale',
                    ]} aria-labelledby={`lyrics-stanza-${stanza.label}`}>
                        <h3 id={`lyrics-stanza-${stanza.label}`}>{stanza.label}</h3>
                        <p class="concert-lyrics__lines">
                            {stanza.lines.map((line, lineIndex) => (
                                <span
                                    class:list={[
                                        'concert-lyrics__line',
                                        lineIndex === stanza.lines.length - 1 && stanza.finale && 'is-final-line',
                                    ]}
                                    data-lyric-line
                                    data-start={concert2026LyricStartTimes[lyricLineIndex++]}
                                >
                                    {line}
                                </span>
                            ))}
                        </p>
                    </section>
                ))}
            </div>
        </div>
    </div>

    <aside
        class="concert-lyrics-player"
        data-lyrics-player
        data-visible="false"
        data-collapsed="true"
        aria-label="明天會更好伴奏播放器"
    >
        <audio
            data-lyrics-audio
            data-download-bytes={concert2026Instrumental.bytes}
            src={concert2026Instrumental.src}
            preload="none"
        ></audio>
        <audio
            data-guide-vocal-audio
            data-download-bytes={concert2026GuideVocal.bytes}
            src={concert2026GuideVocal.src}
            preload="none"
        ></audio>

        <div class="concert-lyrics-player__heading">
            <div>
                <span>大合唱</span>
                <strong>明天會更好</strong>
            </div>
            <div class="concert-lyrics-player__heading-actions">
                <div class="concert-audio-sources" data-audio-preflight data-state="waiting" aria-label="播放資源狀態">
                    <div class="concert-audio-source is-instrumental" data-audio-source="instrumental" data-open="false">
                        <button
                            class="concert-audio-source__trigger"
                            type="button"
                            data-audio-asset-toggle="instrumental"
                            aria-controls="concert-audio-instrumental-panel"
                            aria-expanded="false"
                            aria-label="伴奏準備中 0%，顯示詳細狀態"
                        >
                            <svg class="concert-audio-source__ring" viewBox="0 0 44 44" aria-hidden="true">
                                <circle class="is-track" cx="22" cy="22" r="18" pathLength="100"></circle>
                                <circle class="is-progress" cx="22" cy="22" r="18" pathLength="100"></circle>
                            </svg>
                            <svg class="concert-audio-source__check" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="m6.5 12.5 3.5 3.5 7.5-8"></path>
                            </svg>
                            <span data-audio-asset-icon-text aria-hidden="true">0</span>
                        </button>
                        <div
                            id="concert-audio-instrumental-panel"
                            class="concert-audio-source__panel"
                            role="group"
                            aria-label="伴奏狀態與維護"
                        >
                            <div class="concert-audio-track" data-audio-asset-control="instrumental">
                                <div
                                    class="concert-audio-track-status"
                                    data-audio-asset-status="instrumental"
                                    data-state="waiting"
                                    role="progressbar"
                                    aria-label="伴奏載入進度"
                                    aria-valuemin="0"
                                    aria-valuemax="100"
                                    aria-valuenow="0"
                                >
                                    <span class="concert-audio-track-status__indicator" aria-hidden="true">
                                        <svg class="is-ring" viewBox="0 0 24 24">
                                            <circle class="is-track" cx="12" cy="12" r="9" pathLength="100"></circle>
                                            <circle class="is-progress" cx="12" cy="12" r="9" pathLength="100"></circle>
                                        </svg>
                                        <svg class="is-check" viewBox="0 0 24 24"><path d="m7 12.5 3.2 3.2L17.5 8"></path></svg>
                                        <span data-audio-asset-icon-text>0</span>
                                    </span>
                                    <span class="concert-audio-track-status__copy">
                                        <strong>伴奏</strong>
                                        <small data-audio-asset-label>等待載入</small>
                                    </span>
                                    <output data-audio-asset-percent>0%</output>
                                </div>
                                <div class="concert-audio-track__actions">
                                    <button type="button" data-audio-asset-test="instrumental" aria-label="測試播放伴奏">
                                        <svg class="is-play" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 7 8 5-8 5z"></path></svg>
                                        <svg class="is-stop" viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="8" height="8" rx="1"></rect></svg>
                                        <span data-audio-asset-test-label>測試播放</span>
                                    </button>
                                    <button type="button" data-audio-asset-resync="instrumental" aria-label="清除並重新同步伴奏">
                                        <svg class="is-sync" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M19 8a7 7 0 1 0 1 6"></path><path d="M19 3v5h-5"></path>
                                        </svg>
                                        <span data-audio-asset-resync-label>重新同步</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="concert-audio-source is-guide-vocal" data-audio-source="guide-vocal" data-open="false">
                        <button
                            class="concert-audio-source__trigger"
                            type="button"
                            data-audio-asset-toggle="guide-vocal"
                            aria-controls="concert-audio-guide-vocal-panel"
                            aria-expanded="false"
                            aria-label="導唱準備中 0%，顯示詳細狀態"
                        >
                            <svg class="concert-audio-source__ring" viewBox="0 0 44 44" aria-hidden="true">
                                <circle class="is-track" cx="22" cy="22" r="18" pathLength="100"></circle>
                                <circle class="is-progress" cx="22" cy="22" r="18" pathLength="100"></circle>
                            </svg>
                            <svg class="concert-audio-source__check" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="m6.5 12.5 3.5 3.5 7.5-8"></path>
                            </svg>
                            <span data-audio-asset-icon-text aria-hidden="true">0</span>
                        </button>
                        <div
                            id="concert-audio-guide-vocal-panel"
                            class="concert-audio-source__panel"
                            role="group"
                            aria-label="導唱狀態與維護"
                        >
                            <div class="concert-audio-track" data-audio-asset-control="guide-vocal">
                                <div
                                    class="concert-audio-track-status"
                                    data-audio-asset-status="guide-vocal"
                                    data-state="waiting"
                                    role="progressbar"
                                    aria-label="導唱 Vocal 載入進度"
                                    aria-valuemin="0"
                                    aria-valuemax="100"
                                    aria-valuenow="0"
                                >
                                    <span class="concert-audio-track-status__indicator" aria-hidden="true">
                                        <svg class="is-ring" viewBox="0 0 24 24">
                                            <circle class="is-track" cx="12" cy="12" r="9" pathLength="100"></circle>
                                            <circle class="is-progress" cx="12" cy="12" r="9" pathLength="100"></circle>
                                        </svg>
                                        <svg class="is-check" viewBox="0 0 24 24"><path d="m7 12.5 3.2 3.2L17.5 8"></path></svg>
                                        <span data-audio-asset-icon-text>0</span>
                                    </span>
                                    <span class="concert-audio-track-status__copy">
                                        <strong>導唱</strong>
                                        <small data-audio-asset-label>Vocal · 等待載入</small>
                                    </span>
                                    <output data-audio-asset-percent>0%</output>
                                </div>
                                <div class="concert-audio-track__actions">
                                    <button type="button" data-audio-asset-test="guide-vocal" aria-label="測試播放導唱">
                                        <svg class="is-play" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 7 8 5-8 5z"></path></svg>
                                        <svg class="is-stop" viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="8" height="8" rx="1"></rect></svg>
                                        <span data-audio-asset-test-label>測試播放</span>
                                    </button>
                                    <button type="button" data-audio-asset-resync="guide-vocal" aria-label="清除並重新同步導唱">
                                        <svg class="is-sync" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M19 8a7 7 0 1 0 1 6"></path><path d="M19 3v5h-5"></path>
                                        </svg>
                                        <span data-audio-asset-resync-label>重新同步</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <button class="concert-audio-sources__retry" type="button" data-audio-load-retry hidden>重新載入播放資源</button>
                    <strong class="sr-only" data-audio-preflight-label>準備播放資源</strong>
                    <span class="sr-only" data-audio-preflight-detail>伴奏與導唱完整載入後才可播放</span>
                    <output class="sr-only" data-audio-preflight-percent>0%</output>
                    <div class="sr-only" data-audio-preflight-progress role="progressbar" aria-label="播放資源載入進度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></div>
                    <p class="sr-only" data-audio-preflight-status aria-live="polite">開始準備播放資源</p>
                </div>
                <button
                    class="concert-lyrics-player__follow"
                    type="button"
                    data-follow-toggle
                    aria-pressed="true"
                    title="自動跟隨目前歌詞"
                >
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="7"></circle>
                        <circle cx="12" cy="12" r="2"></circle>
                        <path d="M12 2v3M12 19v3M2 12h3M19 12h3"></path>
                    </svg>
                    <span>跟隨</span>
                </button>
                <button
                    class="concert-lyrics-player__size-toggle"
                    type="button"
                    data-player-size-toggle
                    aria-controls="concert-lyrics-player-details"
                    aria-expanded="false"
                    title="展開播放器"
                >
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path class="is-expand" d="m7 15 5-5 5 5"></path>
                        <path class="is-collapse" d="m7 9 5 5 5-5"></path>
                    </svg>
                    <span class="sr-only" data-player-size-label>展開播放器</span>
                </button>
            </div>
        </div>

        <div class="concert-lyrics-player__load-progress" data-audio-load-progress aria-hidden="true">
            <span></span>
        </div>
        <p class="sr-only" data-audio-load-label>正在準備播放資源</p>
        <p class="sr-only" data-audio-load-status aria-live="polite"></p>

        <div id="concert-lyrics-player-details" class="concert-lyrics-player__details">
            <p class="concert-lyrics-player__current" data-current-lyric>準備播放</p>

            <div class="concert-lyrics-player__controls">
                <button class="concert-lyrics-player__play" type="button" data-play-toggle aria-label="播放伴奏">
                    <svg class="concert-lyrics-player__play-load-ring" viewBox="0 0 44 44" aria-hidden="true">
                        <circle class="is-track" cx="22" cy="22" r="20" pathLength="100"></circle>
                        <circle class="is-progress" cx="22" cy="22" r="20" pathLength="100"></circle>
                    </svg>
                    <span class="concert-lyrics-player__play-load-percent" data-instrumental-load-percent aria-hidden="true">0</span>
                    <svg class="is-play" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 7 8 5-8 5z"></path></svg>
                    <svg class="is-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 7v10M15 7v10"></path></svg>
                    <svg class="is-loading" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="8"></circle>
                    </svg>
                </button>
                <input
                    type="range"
                    min="0"
                    max={concert2026Instrumental.duration}
                    step="0.1"
                    value="0"
                    data-audio-progress
                    aria-label="伴奏播放進度"
                />
                <output data-audio-time>0:00 / 2:35</output>
            </div>

            <label class="concert-lyrics-player__guide-vocal">
                <span>
                    <strong>導唱</strong>
                    <small>Vocal</small>
                </span>
                <input
                    type="range"
                    min="0"
                    max="100"
                    step="1"
                    value={Math.round(concert2026GuideVocal.defaultVolume * 100)}
                    data-guide-vocal-volume
                    aria-label="導唱音量"
                />
                <output data-guide-vocal-output>{Math.round(concert2026GuideVocal.defaultVolume * 100)}%</output>
            </label>
        </div>
    </aside>
</section>

<script>
    import {
        loadConcertAudioAsset,
        openConcertAudioCache,
        type ConcertAudioAssetOrigin,
        type ConcertAudioStore,
    } from '../../lib/concert-audio-cache';

    const lyricsSection = document.querySelector<HTMLElement>('.concert-lyrics');
    const player = document.querySelector<HTMLElement>('[data-lyrics-player]');
    const audio = player?.querySelector<HTMLAudioElement>('[data-lyrics-audio]');
    const guideVocal = player?.querySelector<HTMLAudioElement>('[data-guide-vocal-audio]');
    const playToggle = player?.querySelector<HTMLButtonElement>('[data-play-toggle]');
    const followToggle = player?.querySelector<HTMLButtonElement>('[data-follow-toggle]');
    const playerSizeToggle = player?.querySelector<HTMLButtonElement>('[data-player-size-toggle]');
    const playerSizeLabel = player?.querySelector<HTMLElement>('[data-player-size-label]');
    const progress = player?.querySelector<HTMLInputElement>('[data-audio-progress]');
    const guideVocalVolume = player?.querySelector<HTMLInputElement>('[data-guide-vocal-volume]');
    const guideVocalOutput = player?.querySelector<HTMLOutputElement>('[data-guide-vocal-output]');
    const timeOutput = player?.querySelector<HTMLOutputElement>('[data-audio-time]');
    const currentLyric = player?.querySelector<HTMLElement>('[data-current-lyric]');
    const audioLoadLabel = player?.querySelector<HTMLElement>('[data-audio-load-label]');
    const audioLoadStatus = player?.querySelector<HTMLElement>('[data-audio-load-status]');
    const audioPreflight = document.querySelector<HTMLElement>('[data-audio-preflight]');
    const audioAssetToggleButtons = audioPreflight
        ? Array.from(audioPreflight.querySelectorAll<HTMLButtonElement>('[data-audio-asset-toggle]'))
        : [];
    const audioSourceElements = audioPreflight
        ? Array.from(audioPreflight.querySelectorAll<HTMLElement>('[data-audio-source]'))
        : [];
    const audioPreflightLabel = audioPreflight?.querySelector<HTMLElement>('[data-audio-preflight-label]');
    const audioPreflightDetail = audioPreflight?.querySelector<HTMLElement>('[data-audio-preflight-detail]');
    const audioPreflightPercent = audioPreflight?.querySelector<HTMLOutputElement>('[data-audio-preflight-percent]');
    const audioPreflightProgress = audioPreflight?.querySelector<HTMLElement>('[data-audio-preflight-progress]');
    const audioPreflightStatus = audioPreflight?.querySelector<HTMLElement>('[data-audio-preflight-status]');
    const audioLoadRetry = audioPreflight?.querySelector<HTMLButtonElement>('[data-audio-load-retry]');
    const audioAssetTestButtons = audioPreflight
        ? Array.from(audioPreflight.querySelectorAll<HTMLButtonElement>('[data-audio-asset-test]'))
        : [];
    const audioAssetResyncButtons = audioPreflight
        ? Array.from(audioPreflight.querySelectorAll<HTMLButtonElement>('[data-audio-asset-resync]'))
        : [];
    const audioAssetStatusElements = audioPreflight
        ? Array.from(audioPreflight.querySelectorAll<HTMLElement>('[data-audio-asset-status]'))
        : [];
    const lyricLines = Array.from(document.querySelectorAll<HTMLElement>('[data-lyric-line]'));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const lyricTimelineEnd = Number(lyricsSection?.dataset.lyricsEnd || 0);

    if (
        lyricsSection && player && audio && guideVocal && playToggle && followToggle && playerSizeToggle && playerSizeLabel && progress
        && guideVocalVolume && guideVocalOutput && timeOutput && currentLyric && audioLoadLabel && audioLoadStatus
        && audioPreflight && audioPreflightLabel && audioPreflightDetail
        && audioPreflightPercent && audioPreflightProgress && audioPreflightStatus
        && audioLoadRetry && audioAssetStatusElements.length === 2
        && audioAssetToggleButtons.length === 2 && audioSourceElements.length === 2
        && audioAssetTestButtons.length === 2 && audioAssetResyncButtons.length === 2 && lyricLines.length
    ) {
        let following = true;
        let lyricsInView = false;
        let activeLineIndex = -1;
        let animationFrame = 0;
        let loading = false;
        let assetsPreparing = false;
        let assetsReady = false;
        let openAssetStatusKey: AudioAssetKey | null = null;
        let resyncingAssetKey: AudioAssetKey | null = null;
        let testingAssetKey: AudioAssetKey | null = null;
        let testSource: AudioBufferSourceNode | null = null;
        let testTimer = 0;
        let preparationPromise: Promise<void> | null = null;
        let loadPercent = 0;
        let lastAnnouncedMilestone = -1;
        let playbackOffset = 0;
        let playbackStartedAt = 0;
        let mainPlaying = false;
        let resumeAfterSeek = false;
        let audioContext: AudioContext | null = null;
        let mainSources: AudioBufferSourceNode[] = [];
        let mainGuideGain: GainNode | null = null;
        const tapFeedbackTimers = new WeakMap<HTMLElement, number>();
        const guideVocalStorageKey = 'concert-2026-guide-vocal-volume';
        const objectUrls: string[] = [];
        const assetProgress = new Map<string, number>();
        const assetOrigins = new Map<AudioAssetKey, ConcertAudioAssetOrigin>();
        const decodedAudio = new Map<AudioAssetKey, AudioBuffer>();
        const mobilePlayer = window.matchMedia('(max-width: 760px)');
        type AudioAssetKey = 'instrumental' | 'guide-vocal';
        const audioAssets = [
            {
                key: 'instrumental' as const,
                source: audio.src,
                expectedBytes: Number(audio.dataset.downloadBytes || 0),
                element: audio,
                testOffset: 2,
            },
            {
                key: 'guide-vocal' as const,
                source: guideVocal.src,
                expectedBytes: Number(guideVocal.dataset.downloadBytes || 0),
                element: guideVocal,
                testOffset: 6,
            },
        ];
        const totalExpectedBytes = audioAssets.reduce((total, asset) => total + asset.expectedBytes, 0);
        const audioAssetStatusRows = new Map(audioAssetStatusElements.map((element) => [
            element.dataset.audioAssetStatus,
            {
                element,
                label: element.querySelector<HTMLElement>('[data-audio-asset-label]'),
                percent: element.querySelector<HTMLOutputElement>('[data-audio-asset-percent]'),
                iconText: element.querySelector<HTMLElement>('[data-audio-asset-icon-text]'),
            },
        ]));
        const audioAssetControls = new Map(audioAssets.map((asset) => {
            const control = audioPreflight.querySelector<HTMLElement>(`[data-audio-asset-control="${asset.key}"]`);
            const source = audioPreflight.querySelector<HTMLElement>(`[data-audio-source="${asset.key}"]`);
            const toggle = audioPreflight.querySelector<HTMLButtonElement>(`[data-audio-asset-toggle="${asset.key}"]`);
            const toggleText = toggle?.querySelector<HTMLElement>('[data-audio-asset-icon-text]');
            const testButton = audioPreflight.querySelector<HTMLButtonElement>(`[data-audio-asset-test="${asset.key}"]`);
            const testLabel = testButton?.querySelector<HTMLElement>('[data-audio-asset-test-label]');
            const resyncButton = audioPreflight.querySelector<HTMLButtonElement>(`[data-audio-asset-resync="${asset.key}"]`);
            const resyncLabel = resyncButton?.querySelector<HTMLElement>('[data-audio-asset-resync-label]');
            return [asset.key, { source, toggle, toggleText, control, testButton, testLabel, resyncButton, resyncLabel }];
        }));

        const setPlayerCollapsed = (nextCollapsed: boolean) => {
            const collapsed = mobilePlayer.matches && nextCollapsed;
            player.dataset.collapsed = String(collapsed);
            playerSizeToggle.setAttribute('aria-expanded', String(!collapsed));
            playerSizeToggle.title = collapsed ? '展開播放器' : '收合播放器';
            playerSizeLabel.textContent = playerSizeToggle.title;
        };

        const storedGuideVocalPreference = window.localStorage.getItem(guideVocalStorageKey);
        const storedGuideVocalVolume = storedGuideVocalPreference === null ? Number.NaN : Number(storedGuideVocalPreference);
        const initialGuideVocalVolume = Number.isFinite(storedGuideVocalVolume)
            ? Math.min(1, Math.max(0, storedGuideVocalVolume))
            : Number(guideVocalVolume.value) / 100;
        guideVocal.volume = initialGuideVocalVolume;
        guideVocalVolume.value = String(Math.round(initialGuideVocalVolume * 100));
        guideVocalOutput.value = `${guideVocalVolume.value}%`;
        guideVocalVolume.style.setProperty('--guide-vocal-volume', `${guideVocalVolume.value}%`);

        const refreshBusyState = () => {
            const resyncing = resyncingAssetKey !== null;
            const busy = loading || assetsPreparing || resyncing;
            player.dataset.loading = String(busy);
            player.dataset.preparing = String(assetsPreparing);
            player.dataset.audioReady = String(assetsReady);
            player.dataset.resyncing = String(resyncing);
            if (resyncingAssetKey) player.dataset.resyncingAsset = resyncingAssetKey;
            else delete player.dataset.resyncingAsset;
            playToggle.setAttribute('aria-busy', String(busy));
            playToggle.setAttribute(
                'aria-label',
                assetsPreparing ? `正在準備伴奏 ${loadPercent}%` : loading ? '伴奏載入中' : mainPlaying ? '暫停伴奏' : '播放伴奏',
            );
            playToggle.disabled = !assetsReady || busy || testingAssetKey !== null;
            audioAssetControls.forEach((control, assetKey) => {
                if (control.control) control.control.dataset.testing = String(testingAssetKey === assetKey);
                if (control.control) control.control.dataset.resyncing = String(resyncingAssetKey === assetKey);
                if (control.testButton) {
                    control.testButton.disabled = !assetsReady || busy || (testingAssetKey !== null && testingAssetKey !== assetKey);
                    control.testButton.setAttribute('aria-pressed', String(testingAssetKey === assetKey));
                }
                if (control.testLabel) control.testLabel.textContent = testingAssetKey === assetKey ? '停止測試' : '測試播放';
                if (control.resyncButton) control.resyncButton.disabled = !assetsReady || busy || testingAssetKey !== null;
                if (control.resyncLabel) control.resyncLabel.textContent = resyncingAssetKey === assetKey ? '同步中' : '重新同步';
            });
        };

        const setLoading = (nextLoading: boolean) => {
            loading = nextLoading;
            refreshBusyState();
        };

        const updateAudioAssetStatus = (
            assetKey: string,
            loadedBytes: number,
            forcedState?: 'preparing' | 'ready' | 'failed',
        ) => {
            const asset = audioAssets.find(({ key }) => key === assetKey);
            const status = audioAssetStatusRows.get(assetKey);
            const controls = audioAssetControls.get(assetKey as AudioAssetKey);
            if (!asset || !status || !controls) return;

            const percent = asset.expectedBytes > 0
                ? Math.min(100, Math.round((Math.max(0, loadedBytes) / asset.expectedBytes) * 100))
                : 0;
            const state = forcedState ?? (percent >= 100 ? 'ready' : 'preparing');
            status.element.dataset.state = state;
            status.element.style.setProperty('--asset-load-progress-number', String(percent));
            status.element.setAttribute('aria-valuenow', String(percent));
            if (controls.source) {
                controls.source.dataset.state = state;
                controls.source.style.setProperty('--asset-load-progress-number', String(percent));
            }
            if (assetKey === 'instrumental') {
                player.dataset.instrumentalState = state;
                player.style.setProperty('--instrumental-load-progress-number', String(percent));
                const playLoadPercent = playToggle.querySelector<HTMLElement>('[data-instrumental-load-percent]');
                if (playLoadPercent) playLoadPercent.textContent = String(percent);
            }
            if (controls.toggle) {
                controls.toggle.setAttribute('aria-label', state === 'ready'
                    ? `${assetKey === 'guide-vocal' ? '導唱' : '伴奏'}已就緒，顯示詳細狀態`
                    : state === 'failed'
                        ? `${assetKey === 'guide-vocal' ? '導唱' : '伴奏'}載入失敗，顯示重新同步選項`
                        : `${assetKey === 'guide-vocal' ? '導唱' : '伴奏'}準備中 ${percent}%，顯示詳細狀態`);
            }
            if (controls.toggleText) controls.toggleText.textContent = state === 'ready' ? '' : state === 'failed' ? '!' : String(percent);
            if (status.percent) status.percent.value = state === 'failed' ? '—' : `${percent}%`;
            if (status.iconText) status.iconText.textContent = state === 'ready' ? '' : state === 'failed' ? '!' : String(percent);
            if (status.label) {
                const origin = assetOrigins.get(assetKey as AudioAssetKey);
                const originLabel = origin === 'cache' ? '本機快取' : origin === 'network' ? '網路下載' : '完整載入';
                status.label.textContent = state === 'ready'
                    ? assetKey === 'guide-vocal' ? `Vocal · ${originLabel}` : originLabel
                    : state === 'failed'
                        ? assetKey === 'guide-vocal' ? 'Vocal · 載入失敗' : '載入失敗'
                        : assetKey === 'guide-vocal' ? 'Vocal · 正在載入' : '正在載入';
            }
        };

        const updateDownloadProgress = (assetKey: string, loadedBytes: number) => {
            const asset = audioAssets.find(({ key }) => key === assetKey);
            const boundedLoadedBytes = asset
                ? Math.min(asset.expectedBytes, Math.max(0, loadedBytes))
                : Math.max(0, loadedBytes);
            assetProgress.set(assetKey, boundedLoadedBytes);
            updateAudioAssetStatus(assetKey, boundedLoadedBytes);
            const totalLoadedBytes = [...assetProgress.values()].reduce((total, loaded) => total + loaded, 0);
            loadPercent = totalExpectedBytes > 0
                ? Math.min(100, Math.round((totalLoadedBytes / totalExpectedBytes) * 100))
                : 0;
            player.style.setProperty('--audio-load-progress', `${loadPercent}%`);
            player.style.setProperty('--audio-load-progress-number', String(loadPercent));
            audioPreflight.style.setProperty('--audio-load-progress', `${loadPercent}%`);
            audioPreflight.style.setProperty('--audio-load-progress-number', String(loadPercent));
            audioPreflightPercent.value = `${loadPercent}%`;
            audioPreflightProgress.setAttribute('aria-valuenow', String(loadPercent));

            if (assetsPreparing) {
                audioLoadLabel.textContent = `正在準備 · ${loadPercent}%`;
                audioPreflightLabel.textContent = '正在準備播放資源';
            }
            const milestone = Math.min(100, Math.floor(loadPercent / 25) * 25);
            if (assetsPreparing && milestone !== lastAnnouncedMilestone) {
                lastAnnouncedMilestone = milestone;
                audioLoadStatus.textContent = `伴奏準備進度 ${milestone}%`;
            }
            refreshBusyState();
        };

        const getAudioContext = () => {
            if (audioContext) return audioContext;
            const AudioContextConstructor = window.AudioContext
                ?? (window as typeof window & { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
            if (!AudioContextConstructor) throw new Error('Web Audio API is unavailable');
            audioContext = new AudioContextConstructor({ latencyHint: 'playback' });
            return audioContext;
        };

        const decodeAudioBlob = async (blob: Blob) => {
            const context = getAudioContext();
            return context.decodeAudioData(await blob.arrayBuffer());
        };

        const installAudioBlob = (asset: (typeof audioAssets)[number], blob: Blob) => {
            const previousObjectUrl = asset.element.src.startsWith('blob:') ? asset.element.src : null;
            const objectUrl = URL.createObjectURL(blob);
            objectUrls.push(objectUrl);
            asset.element.src = objectUrl;
            asset.element.preload = 'metadata';
            asset.element.load();
            return { objectUrl, previousObjectUrl };
        };

        const releaseObjectUrl = (objectUrl: string | null) => {
            if (!objectUrl) return;
            const index = objectUrls.indexOf(objectUrl);
            if (index >= 0) objectUrls.splice(index, 1);
            URL.revokeObjectURL(objectUrl);
        };

        const downloadAudioAsset = async (
            asset: (typeof audioAssets)[number],
            cache: ConcertAudioStore | null,
            forceNetwork = false,
        ) => {
            const result = await loadConcertAudioAsset({
                source: asset.source,
                expectedBytes: asset.expectedBytes,
                cache,
                forceNetwork,
                onProgress: (loadedBytes) => updateDownloadProgress(asset.key, loadedBytes),
            });
            assetOrigins.set(asset.key, result.origin);
            return result.blob;
        };

        const showAudioReadyState = (statusMessage = '伴奏與導唱已完整載入，播放時不再依賴網路') => {
            assetsReady = true;
            loadPercent = 100;
            player.style.setProperty('--audio-load-progress', '100%');
            player.style.setProperty('--audio-load-progress-number', '100');
            audioPreflight.style.setProperty('--audio-load-progress', '100%');
            audioPreflight.style.setProperty('--audio-load-progress-number', '100');
            audioPreflight.dataset.state = 'ready';
            audioPreflightLabel.textContent = '播放資源已就緒';
            audioPreflightDetail.textContent = '伴奏已完整載入';
            audioPreflightPercent.value = '100%';
            audioPreflightProgress.setAttribute('aria-valuenow', '100');
            audioAssets.forEach((asset) => updateAudioAssetStatus(asset.key, asset.expectedBytes, 'ready'));
            audioLoadRetry.hidden = true;
            audioLoadLabel.textContent = '播放資源已就緒';
            audioLoadStatus.textContent = '伴奏準備完成，播放時不再依賴網路';
            audioPreflightStatus.textContent = statusMessage;
        };

        const prepareAudioAssets = () => {
            if (assetsReady) return Promise.resolve();
            if (preparationPromise) return preparationPromise;

            assetsPreparing = true;
            lastAnnouncedMilestone = -1;
            audioPreflight.dataset.state = 'preparing';
            audioPreflightLabel.textContent = '正在準備播放資源';
            audioPreflightDetail.textContent = '伴奏與導唱完整載入後才可播放';
            audioPreflightPercent.value = '0%';
            audioLoadRetry.hidden = true;
            audioLoadLabel.textContent = '正在準備 · 0%';
            audioLoadStatus.textContent = '開始準備完整伴奏';
            audioAssets.forEach((asset) => {
                assetProgress.set(asset.key, 0);
                updateAudioAssetStatus(asset.key, 0, 'preparing');
            });
            player.style.setProperty('--audio-load-progress', '0%');
            refreshBusyState();
            updatePlayerVisibility();

            preparationPromise = (async () => {
                const cache = await openConcertAudioCache();
                const blobs = await Promise.all(audioAssets.map((asset) => downloadAudioAsset(asset, cache)));
                audioPreflightDetail.textContent = '下載完成，正在建立同步播放時鐘';
                const buffers = await Promise.all(blobs.map((blob) => decodeAudioBlob(blob)));
                audioAssets.forEach((asset, index) => {
                    decodedAudio.set(asset.key, buffers[index]);
                    installAudioBlob(asset, blobs[index]);
                });
                showAudioReadyState();
                currentLyric.textContent = '準備播放';
            })().catch((error) => {
                audioPreflight.dataset.state = 'failed';
                audioPreflightLabel.textContent = '播放資源準備失敗';
                audioPreflightDetail.textContent = '請確認網路後重新載入';
                audioPreflightPercent.value = '';
                audioAssets.forEach((asset) => {
                    const loadedBytes = assetProgress.get(asset.key) ?? 0;
                    if (loadedBytes < asset.expectedBytes) updateAudioAssetStatus(asset.key, loadedBytes, 'failed');
                });
                audioLoadRetry.hidden = false;
                audioLoadLabel.textContent = '準備失敗 · 點播放重試';
                audioLoadStatus.textContent = '伴奏下載失敗，請確認網路後再試一次';
                audioPreflightStatus.textContent = '播放資源下載失敗，請確認網路後重新載入';
                currentLyric.textContent = '伴奏下載失敗，請再試一次';
                throw error;
            }).finally(() => {
                assetsPreparing = false;
                preparationPromise = null;
                refreshBusyState();
                updatePlayerVisibility();
            });

            return preparationPromise;
        };

        const resyncAudioAsset = async (assetKey: AudioAssetKey) => {
            if (assetsPreparing || loading || resyncingAssetKey || testingAssetKey) return;
            const asset = audioAssets.find(({ key }) => key === assetKey);
            if (!asset || !decodedAudio.has(assetKey)) return;

            pausePlayback();
            stopAssetTest();
            resyncingAssetKey = assetKey;
            openAssetStatusKey = assetKey;
            assetProgress.set(assetKey, 0);
            updateAudioAssetStatus(assetKey, 0, 'preparing');
            audioPreflight.dataset.state = 'preparing';
            audioPreflightLabel.textContent = assetKey === 'guide-vocal' ? '正在重新同步導唱' : '正在重新同步伴奏';
            audioPreflightDetail.textContent = '只更新這一軌，另一軌保持原狀';
            refreshBusyState();
            updatePlayerVisibility();

            let cache: ConcertAudioStore | null = null;
            let previousCachedResponse: Response | undefined;
            try {
                cache = await openConcertAudioCache();
                previousCachedResponse = cache ? await cache.get(asset.source) : undefined;
                if (cache) await cache.delete(asset.source);
                const blob = await downloadAudioAsset(asset, cache, true);
                audioPreflightDetail.textContent = '下載完成，正在驗證並建立同步播放資料';
                const buffer = await decodeAudioBlob(blob);
                const { previousObjectUrl } = installAudioBlob(asset, blob);
                decodedAudio.set(assetKey, buffer);
                releaseObjectUrl(previousObjectUrl);
                showAudioReadyState(`${assetKey === 'guide-vocal' ? '導唱' : '伴奏'}已清除快取並重新同步完成`);
                currentLyric.textContent = '單軌重新同步完成，準備播放';
            } catch {
                if (cache && previousCachedResponse) await cache.put(asset.source, previousCachedResponse).catch(() => undefined);
                showAudioReadyState(`${assetKey === 'guide-vocal' ? '導唱' : '伴奏'}重新同步失敗，仍使用本頁原本已完整載入的版本`);
                currentLyric.textContent = '單軌重新同步失敗，仍可使用原本版本';
            } finally {
                resyncingAssetKey = null;
                refreshBusyState();
                updatePlayerVisibility();
            }
        };

        const replayTapFeedback = (control: HTMLElement) => {
            const previousTimer = tapFeedbackTimers.get(control);
            if (previousTimer) window.clearTimeout(previousTimer);
            control.classList.remove('is-tapped');
            void control.offsetWidth;
            control.classList.add('is-tapped');
            tapFeedbackTimers.set(control, window.setTimeout(() => {
                control.classList.remove('is-tapped');
                tapFeedbackTimers.delete(control);
            }, 320));
        };

        const rangeInputs = [progress, guideVocalVolume];
        const stopRangeInteraction = () => {
            rangeInputs.forEach((input) => {
                input.dataset.interacting = 'false';
            });
        };

        rangeInputs.forEach((input) => {
            input.addEventListener('pointerdown', () => {
                stopRangeInteraction();
                input.dataset.interacting = 'true';
            });
            input.addEventListener('pointercancel', stopRangeInteraction);
            input.addEventListener('blur', stopRangeInteraction);
            input.addEventListener('change', stopRangeInteraction);
        });
        window.addEventListener('pointerup', stopRangeInteraction);

        const formatTime = (seconds: number) => {
            const safeSeconds = Number.isFinite(seconds) ? Math.max(0, Math.floor(seconds)) : 0;
            return `${Math.floor(safeSeconds / 60)}:${String(safeSeconds % 60).padStart(2, '0')}`;
        };

        const getPlaybackDuration = () => decodedAudio.get('instrumental')?.duration ?? Number(progress.max);

        const getPlaybackTime = () => {
            if (!mainPlaying || !audioContext) return playbackOffset;
            return Math.min(getPlaybackDuration(), playbackOffset + Math.max(0, audioContext.currentTime - playbackStartedAt));
        };

        const stopMainSources = () => {
            mainSources.forEach((source) => {
                source.onended = null;
                try { source.stop(); } catch { /* The source may already have ended. */ }
                source.disconnect();
            });
            mainSources = [];
            mainGuideGain = null;
        };

        const createScheduledSource = (
            assetKey: AudioAssetKey,
            gainValue: number,
            when: number,
            offset: number,
            duration?: number,
        ) => {
            const context = getAudioContext();
            const buffer = decodedAudio.get(assetKey);
            if (!buffer) throw new Error(`Decoded ${assetKey} audio is unavailable`);
            const source = context.createBufferSource();
            const gain = context.createGain();
            source.buffer = buffer;
            gain.gain.value = gainValue;
            source.connect(gain).connect(context.destination);
            if (duration === undefined) source.start(when, offset);
            else source.start(when, offset, duration);
            return { source, gain };
        };

        const pausePlayback = () => {
            if (mainPlaying) playbackOffset = getPlaybackTime();
            mainPlaying = false;
            stopMainSources();
            window.cancelAnimationFrame(animationFrame);
            updatePlaybackState();
            renderProgress();
        };

        const stopAssetTest = (stopSource = true) => {
            if (testTimer) window.clearTimeout(testTimer);
            testTimer = 0;
            if (testSource) {
                testSource.onended = null;
                if (stopSource) {
                    try { testSource.stop(); } catch { /* The test source may already have ended. */ }
                }
                testSource.disconnect();
            }
            testSource = null;
            testingAssetKey = null;
            audioPreflightStatus.textContent = '單軌測試已停止，兩軌仍保持完整載入';
            refreshBusyState();
            updatePlayerVisibility();
        };

        const toggleAssetTest = async (assetKey: AudioAssetKey) => {
            if (!assetsReady || assetsPreparing || resyncingAssetKey || loading) return;
            if (testingAssetKey === assetKey) {
                stopAssetTest();
                return;
            }

            stopAssetTest();
            pausePlayback();
            const context = getAudioContext();
            await context.resume();
            const asset = audioAssets.find(({ key }) => key === assetKey);
            if (!asset) return;
            testingAssetKey = assetKey;
            const when = context.currentTime + 0.04;
            testSource = createScheduledSource(assetKey, assetKey === 'guide-vocal' ? 0.7 : 1, when, asset.testOffset, 6).source;
            testSource.onended = () => stopAssetTest(false);
            testTimer = window.setTimeout(() => stopAssetTest(), 6200);
            audioPreflightStatus.textContent = `正在單獨測試${assetKey === 'guide-vocal' ? '導唱' : '伴奏'}，6 秒後自動停止`;
            refreshBusyState();
            updatePlayerVisibility();
        };

        const updatePlayerVisibility = () => {
            const resourceOnly = false;
            player.dataset.resourceStatusOpen = String(openAssetStatusKey !== null);
            audioSourceElements.forEach((source) => {
                const assetKey = source.dataset.audioSource as AudioAssetKey;
                const open = openAssetStatusKey === assetKey;
                source.dataset.open = String(open);
                audioAssetControls.get(assetKey)?.toggle?.setAttribute('aria-expanded', String(open));
            });
            player.dataset.resourceOnly = String(resourceOnly);
            player.dataset.visible = String(Boolean(lyricsInView || mainPlaying || testingAssetKey));
        };

        const setResourceStatusOpen = (assetKey: AudioAssetKey | null) => {
            openAssetStatusKey = assetKey;
            updatePlayerVisibility();
        };

        const setFollowing = (nextFollowing: boolean) => {
            following = nextFollowing;
            followToggle.setAttribute('aria-pressed', String(following));
            followToggle.title = following ? '自動跟隨目前歌詞' : '恢復自動跟隨';
        };

        const followLine = (line: HTMLElement) => {
            const lineTop = line.getBoundingClientRect().top + window.scrollY;
            const targetTop = lineTop - window.innerHeight * 0.38;
            window.scrollTo({
                top: Math.max(0, targetTop),
                behavior: reduceMotion.matches ? 'auto' : 'smooth',
            });
        };

        const updateActiveLine = () => {
            const time = getPlaybackTime();
            let nextIndex = time >= lyricTimelineEnd ? -2 : -1;

            if (nextIndex !== -2) {
                for (let index = 0; index < lyricLines.length; index += 1) {
                    const start = Number(lyricLines[index].dataset.start);
                    if (time >= start) nextIndex = index;
                    else break;
                }
            }

            if (nextIndex === activeLineIndex) return;

            if (activeLineIndex >= 0) {
                lyricLines[activeLineIndex].classList.remove('is-active');
                lyricLines[activeLineIndex].removeAttribute('aria-current');
            }

            activeLineIndex = nextIndex;
            lyricLines.forEach((lyricLine, index) => {
                lyricLine.classList.toggle('is-near', nextIndex >= 0 && Math.abs(index - nextIndex) === 1);
            });
            lyricsSection.dataset.playback = nextIndex >= 0 && mainPlaying ? 'active' : 'idle';

            if (nextIndex === -2) {
                currentLyric.textContent = '尾奏';
                return;
            }

            if (nextIndex < 0) {
                currentLyric.textContent = time > 0 ? '前奏' : '準備播放';
                return;
            }

            const line = lyricLines[nextIndex];
            line.classList.add('is-active');
            line.setAttribute('aria-current', 'true');
            currentLyric.textContent = line.textContent?.trim() || '播放中';

            if (following && mainPlaying) followLine(line);
        };

        const renderProgress = () => {
            const duration = getPlaybackDuration();
            const currentTime = getPlaybackTime();
            progress.max = String(duration);
            progress.value = String(currentTime);
            const percent = duration > 0 ? (currentTime / duration) * 100 : 0;
            progress.style.setProperty('--audio-progress', `${percent}%`);
            timeOutput.textContent = `${formatTime(currentTime)} / ${formatTime(Math.ceil(duration))}`;
            player.dataset.playbackTime = currentTime.toFixed(3);
            updateActiveLine();

            if (mainPlaying) animationFrame = window.requestAnimationFrame(renderProgress);
        };

        const updatePlaybackState = () => {
            player.dataset.playing = String(mainPlaying);
            refreshBusyState();
            lyricsSection.dataset.playback = mainPlaying && activeLineIndex >= 0 ? 'active' : 'idle';
            updatePlayerVisibility();
        };

        const pauseFollowingForManualNavigation = (event: Event) => {
            if (!following || !mainPlaying || player.contains(event.target as Node)) return;
            setFollowing(false);
        };

        const startPlayback = async () => {
            setLoading(true);
            try {
                stopAssetTest();
                const context = getAudioContext();
                await context.resume();
                const duration = getPlaybackDuration();
                if (playbackOffset >= duration - 0.05) playbackOffset = 0;
                const when = context.currentTime + 0.06;
                const guideGain = Number(guideVocalVolume.value) / 100;
                const instrumentalPlayback = createScheduledSource('instrumental', 1, when, playbackOffset);
                const guidePlayback = createScheduledSource('guide-vocal', guideGain, when, playbackOffset);
                mainSources = [instrumentalPlayback.source, guidePlayback.source];
                mainGuideGain = guidePlayback.gain;
                playbackStartedAt = when;
                mainPlaying = true;
                instrumentalPlayback.source.onended = () => {
                    if (!mainPlaying) return;
                    playbackOffset = getPlaybackDuration();
                    mainPlaying = false;
                    mainSources = [];
                    mainGuideGain = null;
                    window.cancelAnimationFrame(animationFrame);
                    updatePlaybackState();
                    renderProgress();
                    currentLyric.textContent = '播放完畢';
                };
                setLoading(false);
                updatePlaybackState();
                window.cancelAnimationFrame(animationFrame);
                animationFrame = window.requestAnimationFrame(renderProgress);
            } catch (error) {
                mainPlaying = false;
                stopMainSources();
                setLoading(false);
                currentLyric.textContent = error instanceof DOMException && error.name === 'NotAllowedError'
                    ? '伴奏已準備完成，請再按一次播放'
                    : '無法播放，請再試一次';
            }
        };

        playToggle.addEventListener('click', async () => {
            replayTapFeedback(playToggle);

            if (!assetsReady) return;

            if (loading) return;

            if (!mainPlaying) await startPlayback();
            else pausePlayback();
        });

        followToggle.addEventListener('click', () => {
            setFollowing(!following);
            if (following && activeLineIndex >= 0) followLine(lyricLines[activeLineIndex]);
        });

        playerSizeToggle.addEventListener('click', () => {
            replayTapFeedback(playerSizeToggle);
            setPlayerCollapsed(player.dataset.collapsed !== 'true');
        });

        audioAssetToggleButtons.forEach((button) => button.addEventListener('click', () => {
            const assetKey = button.dataset.audioAssetToggle as AudioAssetKey;
            replayTapFeedback(button);
            setResourceStatusOpen(openAssetStatusKey === assetKey ? null : assetKey);
        }));

        const instrumentalPanel = audioAssetControls.get('instrumental')?.control?.closest<HTMLElement>('.concert-audio-source__panel');
        const instrumentalSource = audioAssetControls.get('instrumental')?.source;
        if (instrumentalSource && instrumentalSource.parentElement !== player) player.append(instrumentalSource);
        let instrumentalPanelCloseTimer = 0;
        const positionInstrumentalPanel = () => {
            if (!instrumentalPanel) return;
            const playerRect = player.getBoundingClientRect();
            const playRect = playToggle.getBoundingClientRect();
            const preferredLeft = Math.max(0, playRect.left - playerRect.left);
            const maximumLeft = Math.max(0, playerRect.width - instrumentalPanel.offsetWidth);
            player.style.setProperty('--instrumental-panel-left', `${Math.min(preferredLeft, maximumLeft)}px`);
            player.style.setProperty('--instrumental-panel-bottom', `${Math.max(0, playerRect.bottom - playRect.top + 8)}px`);
        };
        const openInstrumentalPanel = () => {
            window.clearTimeout(instrumentalPanelCloseTimer);
            positionInstrumentalPanel();
            setResourceStatusOpen('instrumental');
        };
        const scheduleInstrumentalPanelClose = () => {
            window.clearTimeout(instrumentalPanelCloseTimer);
            instrumentalPanelCloseTimer = window.setTimeout(() => {
                if (instrumentalPanel?.matches(':hover') || instrumentalPanel?.contains(document.activeElement)) return;
                if (openAssetStatusKey === 'instrumental') setResourceStatusOpen(null);
            }, 280);
        };
        playToggle.addEventListener('pointerenter', openInstrumentalPanel);
        playToggle.addEventListener('pointerleave', scheduleInstrumentalPanelClose);
        playToggle.addEventListener('focus', openInstrumentalPanel);
        playToggle.addEventListener('blur', scheduleInstrumentalPanelClose);
        instrumentalPanel?.addEventListener('pointerenter', () => window.clearTimeout(instrumentalPanelCloseTimer));
        instrumentalPanel?.addEventListener('pointerleave', scheduleInstrumentalPanelClose);
        instrumentalPanel?.addEventListener('focusin', () => window.clearTimeout(instrumentalPanelCloseTimer));
        instrumentalPanel?.addEventListener('focusout', scheduleInstrumentalPanelClose);
        window.addEventListener('resize', positionInstrumentalPanel);

        document.addEventListener('pointerdown', (event) => {
            const target = event.target as Node;
            if (!openAssetStatusKey || audioPreflight.contains(target) || instrumentalPanel?.contains(target) || playToggle.contains(target)) return;
            setResourceStatusOpen(null);
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && openAssetStatusKey) {
                const toggle = audioAssetControls.get(openAssetStatusKey)?.toggle;
                setResourceStatusOpen(null);
                toggle?.focus();
            }
        });

        mobilePlayer.addEventListener('change', ({ matches }) => {
            setPlayerCollapsed(matches);
        });

        progress.addEventListener('pointerdown', () => {
            resumeAfterSeek = mainPlaying;
            if (mainPlaying) pausePlayback();
        });

        progress.addEventListener('input', () => {
            const requestedTime = Number(progress.value);
            if (mainPlaying) {
                resumeAfterSeek = true;
                pausePlayback();
            }
            playbackOffset = Math.min(getPlaybackDuration(), Math.max(0, requestedTime));
            updateActiveLine();
            renderProgress();
        });

        progress.addEventListener('change', () => {
            if (!resumeAfterSeek) return;
            resumeAfterSeek = false;
            void startPlayback();
        });

        guideVocalVolume.addEventListener('input', () => {
            const nextVolume = Number(guideVocalVolume.value) / 100;
            if (mainGuideGain && audioContext) {
                mainGuideGain.gain.setTargetAtTime(nextVolume, audioContext.currentTime, 0.015);
            }
            guideVocalOutput.textContent = `${guideVocalVolume.value}%`;
            guideVocalVolume.style.setProperty('--guide-vocal-volume', `${guideVocalVolume.value}%`);
            window.localStorage.setItem(guideVocalStorageKey, String(nextVolume));
        });

        document.addEventListener('wheel', pauseFollowingForManualNavigation, { passive: true });
        document.addEventListener('touchstart', pauseFollowingForManualNavigation, { passive: true });
        document.addEventListener('pointerdown', pauseFollowingForManualNavigation);
        document.addEventListener('keydown', (event) => {
            if (['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End'].includes(event.key)) {
                pauseFollowingForManualNavigation(event);
            }
        });

        const requestAudioPreparation = () => {
            void prepareAudioAssets().catch(() => undefined);
        };

        audioLoadRetry.addEventListener('click', requestAudioPreparation);
        audioAssetTestButtons.forEach((button) => {
            button.addEventListener('click', () => {
                const assetKey = button.dataset.audioAssetTest as AudioAssetKey;
                replayTapFeedback(button);
                void toggleAssetTest(assetKey);
            });
        });
        audioAssetResyncButtons.forEach((button) => {
            button.addEventListener('click', () => {
                const assetKey = button.dataset.audioAssetResync as AudioAssetKey;
                replayTapFeedback(button);
                void resyncAudioAsset(assetKey);
            });
        });
        requestAudioPreparation();

        window.addEventListener('pagehide', (event) => {
            if (event.persisted) return;
            mainPlaying = false;
            stopMainSources();
            stopAssetTest();
            void audioContext?.close();
            objectUrls.forEach((objectUrl) => URL.revokeObjectURL(objectUrl));
        });

        const sectionObserver = new IntersectionObserver(([entry]) => {
            lyricsInView = entry.isIntersecting;
            updatePlayerVisibility();
        }, { rootMargin: '-12% 0px -12%' });

        sectionObserver.observe(lyricsSection);
        setPlayerCollapsed(mobilePlayer.matches);
        updatePlaybackState();
        renderProgress();
    }
</script>
