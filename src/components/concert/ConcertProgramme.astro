---
import programmeCsv from '../../data/concert-2026-programme.csv?raw';
import { concert2026 } from '../../data/concert-2026';
import { concert2026ProgrammeMediaByNumber } from '../../data/concert-2026-media';
import { parseConcertProgramme } from '../../utils/concertProgramme';

const programme = parseConcertProgramme(programmeCsv);
const halves = [
    {
        id: 'first-half',
        title: '上半場',
        english: 'First half',
        entries: programme.filter((entry) => entry.half === '上半場'),
        meta: `主持人｜${concert2026.hosts.join('、')}`,
    },
    {
        id: 'second-half',
        title: '下半場',
        english: 'Second half',
        entries: programme.filter((entry) => entry.half === '下半場'),
        meta: '',
    },
] as const;
---

<section id="programme" class="concert-programme" aria-labelledby="programme-heading" data-programme-switcher>
    <div class="concert-programme__layout">
        <header class="concert-programme__masthead">
            <div>
                <p class="concert-eyebrow">Programme · 2026</p>
                <h2 id="programme-heading">節目表</h2>
            </div>
            <p>三十個正式節目，上、下半場各十五場演出，並在尾聲迎來一場客串。從獨奏、四手聯彈到合唱，讓一整年的練習在今天被聽見。</p>
        </header>

        <nav class="concert-programme__jump" aria-label="選擇節目半場" data-programme-tabs>
            {halves.map((half, halfIndex) => (
                <a
                    id={`programme-tab-${half.id}`}
                    class="concert-programme__tab"
                    href={`#${half.id}`}
                    aria-controls={half.id}
                    data-programme-tab
                >
                    <span>{halfIndex === 0 ? '01–15' : '16–30'}</span>
                    <strong>{half.title}</strong>
                </a>
            ))}
        </nav>

        <p class="sr-only" aria-live="polite" data-programme-status>目前顯示上半場，第 1 至 15 個節目。</p>

        <div class="concert-programme__paper" data-programme-paper>
            {halves.map((half, halfIndex) => (
                <section
                    id={half.id}
                    class="concert-programme__half"
                    data-programme-panel
                    data-programme-active={halfIndex === 0 ? 'true' : 'false'}
                >
                    <header class="concert-programme__half-heading">
                        <div>
                            <p>{half.english}</p>
                            <h3 id={`${half.id}-heading`} tabindex="-1">{half.title}</h3>
                        </div>
                        {half.meta && <p class="concert-programme__host">{half.meta}</p>}
                    </header>

                    <ol class="concert-programme__list" start={half.entries[0]?.number}>
                        {half.entries.map((entry) => {
                            const programmeMediaKey = entry.number ?? 'guest';
                            const media = concert2026ProgrammeMediaByNumber.get(programmeMediaKey as 11 | 17 | 20 | 'guest');
                            const mediaLabel = media?.kind === 'audio' ? '音訊' : '影片';
                            return (
                            <li class:list={[
                                'concert-programme__entry',
                                entry.details && 'concert-programme__entry--detailed',
                                entry.isMasked && 'concert-programme__entry--masked',
                                (entry.number === null || [16, 17, 30].includes(entry.number)) && 'concert-programme__entry--feature',
                                media && 'concert-programme__entry--media',
                            ]} data-programme-number={entry.number ?? 'guest'}>
                                <span class:list={['concert-programme__number', entry.number === null && 'concert-programme__number--guest']} aria-hidden="true">
                                    {entry.displayLabel || String(entry.number).padStart(2, '0')}
                                </span>

                                <div class="concert-programme__content">
                                    <div class="concert-programme__title-line">
                                        <div class="concert-programme__title-main">
                                            {entry.isMasked ? (
                                                <div class="concert-programme__masked-title" role="heading" aria-level="4" aria-label="曲目遮蔽">
                                                    <span aria-hidden="true"></span>
                                                </div>
                                            ) : (
                                                <h4>{entry.work}</h4>
                                            )}
                                            {entry.format && <span class="concert-programme__format">{entry.format}</span>}
                                        </div>
                                        {media && (
                                            <button
                                                class="concert-programme__media-button"
                                                type="button"
                                                data-programme-media-button
                                                data-media-number={media.number}
                                                data-media-kicker={media.kicker}
                                                data-media-title={media.title}
                                                data-media-performer={entry.performer}
                                                data-media-kind={media.kind}
                                                data-media-source={media.source}
                                                data-media-bytes={media.bytes}
                                                data-media-duration={media.duration}
                                                data-media-repeat={media.repeat}
                                                data-media-aspect={media.aspectRatio}
                                                data-media-credit={media.credit}
                                                data-media-note={media.note || ''}
                                                data-state="loading"
                                                aria-label={`${media.title}${mediaLabel}載入中 0%`}
                                                disabled
                                            >
                                                <svg class="concert-programme__media-ring" viewBox="0 0 44 44" aria-hidden="true">
                                                    <circle class="is-track" cx="22" cy="22" r="18" pathLength="100"></circle>
                                                    <circle class="is-progress" cx="22" cy="22" r="18" pathLength="100"></circle>
                                                </svg>
                                                <svg class="concert-programme__media-play" viewBox="0 0 24 24" aria-hidden="true">
                                                    <path d="m9 7 8 5-8 5z"></path>
                                                </svg>
                                                <svg class="concert-programme__media-retry" viewBox="0 0 24 24" aria-hidden="true">
                                                    <path d="M19 8a7 7 0 1 0 1 6"></path><path d="M19 3v5h-5"></path>
                                                </svg>
                                                <span data-programme-media-percent>0</span>
                                            </button>
                                        )}
                                    </div>

                                    {(entry.performer || entry.details) && (
                                        <div class="concert-programme__meta">
                                            {entry.performer && <p class="concert-programme__performer">{entry.performer}</p>}

                                            {entry.details && (
                                                <div class="concert-programme__details">
                                                    {entry.details.split('\n').map((line) => <p>{line}</p>)}
                                                </div>
                                            )}
                                        </div>
                                    )}
                                </div>
                            </li>
                            );
                        })}
                    </ol>

                    {halfIndex === 0 && (
                        <div class="concert-programme__intermission" aria-label="中場休息">
                            <div class="concert-programme__intermission-label">
                                <span aria-hidden="true"></span>
                                <p>中場休息</p>
                                <span aria-hidden="true"></span>
                            </div>
                            <a
                                class="concert-programme__continue"
                                href="#second-half"
                                data-programme-next
                                aria-label="繼續閱讀下半場，第 16 至 30 個節目"
                            >
                                <small>Next · 16–30</small>
                                <strong>繼續下半場</strong>
                                <span aria-hidden="true">↓</span>
                            </a>
                        </div>
                    )}
                </section>
            ))}
        </div>
    </div>

    <dialog class="concert-programme-media" data-programme-media-dialog aria-labelledby="concert-programme-media-title">
        <div class="concert-programme-media__sheet">
            <header class="concert-programme-media__header">
                <div>
                    <p data-programme-media-kicker>Programme media</p>
                    <p class="concert-programme-media__notice" data-programme-media-notice hidden></p>
                    <h2 id="concert-programme-media-title" data-programme-media-title>影片播放</h2>
                    <p data-programme-media-credit></p>
                </div>
                <button type="button" data-programme-media-close aria-label="關閉影片">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 7 10 10M17 7 7 17"></path></svg>
                </button>
            </header>
            <div class="concert-programme-media__stage" data-programme-media-stage data-aspect="landscape" data-kind="video">
                <video playsinline preload="none" data-programme-media-player="video"></video>
                <div class="concert-programme-media__audio-card" data-programme-media-audio-card hidden>
                    <span class="concert-programme-media__audio-mark" aria-hidden="true">
                        <i></i><i></i><i></i><i></i><i></i>
                    </span>
                    <h3 data-programme-media-audio-title></h3>
                    <p data-programme-media-audio-performer></p>
                    <audio preload="none" data-programme-media-player="audio"></audio>
                </div>

                <div class="concert-programme-media__controls" data-programme-media-controls>
                    <button class="concert-programme-media__play" type="button" data-programme-media-play aria-label="播放">
                        <svg class="is-play" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 9 6-9 6z"></path></svg>
                        <svg class="is-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6v12M16 6v12"></path></svg>
                    </button>

                    <div class="concert-programme-media__timeline">
                        <input type="range" min="0" max="1" step="0.01" value="0" data-programme-media-seek aria-label="播放進度" />
                        <p><span data-programme-media-current>0:00</span><span aria-hidden="true">／</span><span data-programme-media-duration>0:00</span></p>
                    </div>

                    <div class="concert-programme-media__volume">
                        <button type="button" data-programme-media-mute aria-label="靜音">
                            <svg class="is-volume" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 10v4h4l5 4V6L9 10H5z"></path><path d="M17 9a4 4 0 0 1 0 6M19 6a8 8 0 0 1 0 12"></path></svg>
                            <svg class="is-muted" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 10v4h4l5 4V6L9 10H5zM18 10l4 4m0-4-4 4"></path></svg>
                        </button>
                        <input type="range" min="0" max="1" step="0.01" value="1" data-programme-media-volume aria-label="音量" />
                    </div>

                    <div class="concert-programme-media__settings" data-programme-media-settings hidden>
                        <button type="button" data-programme-media-settings-toggle aria-label="播放器設定" aria-expanded="false">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 15.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4Z"></path>
                                <path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.86 2.86-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6 1.7 1.7 0 0 0-.4 1.1V21H9.6v-.1A1.7 1.7 0 0 0 8.5 19.4a1.7 1.7 0 0 0-1.88.34l-.06.06-2.86-2.86.06-.06A1.7 1.7 0 0 0 4.1 15a1.7 1.7 0 0 0-.6-1A1.7 1.7 0 0 0 2.4 13.6H2V9.6h.4A1.7 1.7 0 0 0 4.1 8.5a1.7 1.7 0 0 0-.34-1.88l-.06-.06L6.56 3.7l.06.06A1.7 1.7 0 0 0 8.5 4.1a1.7 1.7 0 0 0 1-.6 1.7 1.7 0 0 0 .4-1.1V2h4v.4A1.7 1.7 0 0 0 15 4.1a1.7 1.7 0 0 0 1.88-.34l.06-.06 2.86 2.86-.06.06A1.7 1.7 0 0 0 19.4 8.5a1.7 1.7 0 0 0 .6 1 1.7 1.7 0 0 0 1.1.4h.4v4h-.4A1.7 1.7 0 0 0 19.4 15Z"></path>
                            </svg>
                        </button>
                        <div class="concert-programme-media__settings-popover" data-programme-media-settings-popover hidden>
                            <button type="button" role="switch" aria-checked="true" data-programme-media-fade-toggle>
                                <span>
                                    <strong>循環淡出</strong>
                                    <small>第一次結尾漸弱後，再接第二次</small>
                                </span>
                                <i aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>

                    <div class="concert-programme-media__cache">
                        <button type="button" data-programme-media-cache-toggle aria-label="開啟快取選項" aria-expanded="false">
                            <svg class="concert-programme-media__cache-ring" viewBox="0 0 44 44" aria-hidden="true">
                                <circle class="is-track" cx="22" cy="22" r="18" pathLength="100"></circle>
                                <circle class="is-progress" cx="22" cy="22" r="18" pathLength="100"></circle>
                            </svg>
                            <svg class="concert-programme-media__cache-check" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 12 3 3 7-7"></path></svg>
                            <span data-programme-media-cache-percent>100</span>
                        </button>
                        <div class="concert-programme-media__cache-popover" data-programme-media-cache-popover hidden>
                            <div>
                                <strong>播放資源</strong>
                                <span data-programme-media-cache-detail>100%</span>
                            </div>
                            <button type="button" data-programme-media-reload>重新載入</button>
                        </div>
                    </div>

                    <button class="concert-programme-media__fullscreen" type="button" data-programme-media-fullscreen aria-label="進入全螢幕">
                        <svg class="is-enter" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5"></path></svg>
                        <svg class="is-exit" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8h5V3M21 8h-5V3M3 16h5v5M21 16h-5v5"></path></svg>
                    </button>
                </div>
            </div>
            <p class="sr-only" data-programme-media-status aria-live="polite">播放資源已就緒</p>
        </div>
    </dialog>
</section>

<script>
    import {
        loadConcertProgrammeMediaAsset,
        openConcertProgrammeMediaCache,
        type ConcertAudioAssetOrigin,
        type ConcertAudioStore,
    } from '../../lib/concert-audio-cache';

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    document.querySelectorAll<HTMLElement>('[data-programme-switcher]').forEach((switcher) => {
        if (switcher.dataset.enhanced === 'true') return;

        const tabs = Array.from(switcher.querySelectorAll<HTMLAnchorElement>('[data-programme-tab]'));
        const panels = Array.from(switcher.querySelectorAll<HTMLElement>('[data-programme-panel]'));
        const tablist = switcher.querySelector<HTMLElement>('[data-programme-tabs]');
        const nextLinks = Array.from(switcher.querySelectorAll<HTMLAnchorElement>('[data-programme-next]'));
        const status = switcher.querySelector<HTMLElement>('[data-programme-status]');
        if (tabs.length !== panels.length || tabs.length === 0) return;

        const hashIndex = panels.findIndex((panel) => `#${panel.id}` === window.location.hash);
        let activeIndex = hashIndex >= 0 ? hashIndex : 0;
        let transitionInProgress = false;
        let queuedIndex: number | null = null;
        let queuedFocus = false;

        tablist?.setAttribute('role', 'tablist');
        tabs.forEach((tab, tabIndex) => {
            tab.setAttribute('role', 'tab');
            tab.setAttribute('aria-selected', tabIndex === activeIndex ? 'true' : 'false');
            tab.tabIndex = tabIndex === activeIndex ? 0 : -1;
        });
        panels.forEach((panel, panelIndex) => {
            panel.setAttribute('role', 'tabpanel');
            panel.setAttribute('aria-labelledby', tabs[panelIndex]?.id ?? '');
        });

        const syncState = (index: number) => {
            tabs.forEach((tab, tabIndex) => {
                const selected = tabIndex === index;
                tab.classList.toggle('is-active', selected);
                tab.setAttribute('aria-selected', selected ? 'true' : 'false');
                tab.tabIndex = selected ? 0 : -1;
            });

            panels.forEach((panel, panelIndex) => {
                const selected = panelIndex === index;
                panel.classList.toggle('is-active', selected);
                panel.dataset.programmeActive = selected ? 'true' : 'false';
                panel.setAttribute('aria-hidden', selected ? 'false' : 'true');
                panel.inert = !selected;
            });

            if (status) {
                status.textContent = index === 0
                    ? '目前顯示上半場，第 1 至 15 個節目。'
                    : '目前顯示下半場，第 16 至 30 個節目。';
            }
        };

        const replaceHash = (panel: HTMLElement) => {
            const nextUrl = new URL(window.location.href);
            nextUrl.hash = panel.id;
            window.history.replaceState(null, '', nextUrl);
        };

        const switchTo = async (nextIndex: number, focusTab = false, updateHash = true) => {
            if (nextIndex === activeIndex && !transitionInProgress) {
                if (focusTab) tabs[nextIndex]?.focus();
                if (updateHash) replaceHash(panels[nextIndex]);
                return;
            }

            if (transitionInProgress) {
                queuedIndex = nextIndex;
                queuedFocus = focusTab;
                return;
            }

            transitionInProgress = true;
            switcher.dataset.transitioning = 'true';

            const previousIndex = activeIndex;
            const outgoing = panels[previousIndex];
            const incoming = panels[nextIndex];
            const direction = nextIndex > previousIndex ? 1 : -1;

            incoming.style.visibility = 'visible';
            incoming.inert = true;
            tabs.forEach((tab, tabIndex) => {
                const selected = tabIndex === nextIndex;
                tab.classList.toggle('is-active', selected);
                tab.setAttribute('aria-selected', selected ? 'true' : 'false');
                tab.tabIndex = selected ? 0 : -1;
            });

            if (!reduceMotion.matches && typeof outgoing.animate === 'function') {
                const timing: KeyframeAnimationOptions = {
                    duration: 430,
                    easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
                    fill: 'both',
                };
                const outgoingAnimation = outgoing.animate([
                    { opacity: 1, transform: 'translateY(0)' },
                    { opacity: 0, transform: `translateY(${direction * -34}px)` },
                ], timing);
                const incomingAnimation = incoming.animate([
                    { opacity: 0, transform: `translateY(${direction * 52}px)` },
                    { opacity: 1, transform: 'translateY(0)' },
                ], timing);

                await Promise.allSettled([outgoingAnimation.finished, incomingAnimation.finished]);
            }

            outgoing.getAnimations().forEach((animation) => animation.cancel());
            incoming.getAnimations().forEach((animation) => animation.cancel());
            outgoing.removeAttribute('style');
            incoming.removeAttribute('style');

            activeIndex = nextIndex;
            syncState(activeIndex);
            if (focusTab) tabs[activeIndex]?.focus();
            if (updateHash) replaceHash(incoming);

            transitionInProgress = false;
            delete switcher.dataset.transitioning;

            if (queuedIndex !== null && queuedIndex !== activeIndex) {
                const nextQueuedIndex = queuedIndex;
                const shouldFocus = queuedFocus;
                queuedIndex = null;
                queuedFocus = false;
                void switchTo(nextQueuedIndex, shouldFocus, true);
            } else {
                queuedIndex = null;
                queuedFocus = false;
            }
        };

        switcher.dataset.enhanced = 'true';
        syncState(activeIndex);

        tabs.forEach((tab, tabIndex) => {
            tab.addEventListener('click', (event) => {
                event.preventDefault();
                void switchTo(tabIndex, false, true);
            });

            tab.addEventListener('keydown', (event) => {
                let nextIndex: number | null = null;
                if (event.key === 'ArrowRight' || event.key === 'ArrowDown') nextIndex = (tabIndex + 1) % tabs.length;
                if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') nextIndex = (tabIndex - 1 + tabs.length) % tabs.length;
                if (event.key === 'Home') nextIndex = 0;
                if (event.key === 'End') nextIndex = tabs.length - 1;
                if (nextIndex === null) return;

                event.preventDefault();
                void switchTo(nextIndex, true, true);
            });
        });

        nextLinks.forEach((link) => {
            link.addEventListener('click', async (event) => {
                const targetId = link.hash.slice(1);
                const nextIndex = panels.findIndex((panel) => panel.id === targetId);
                if (nextIndex < 0) return;

                event.preventDefault();
                await switchTo(nextIndex, false, true);

                const heading = panels[nextIndex]?.querySelector<HTMLElement>('h3');
                requestAnimationFrame(() => {
                    window.setTimeout(() => {
                        panels[nextIndex]?.scrollIntoView({
                            behavior: reduceMotion.matches ? 'auto' : 'smooth',
                            block: 'start',
                        });
                        heading?.focus({ preventScroll: true });

                        window.setTimeout(() => {
                            if (heading && document.activeElement !== heading) {
                                heading.focus({ preventScroll: true });
                            }
                        }, 60);
                    }, 0);
                });
            });
        });

        window.addEventListener('hashchange', () => {
            const nextIndex = panels.findIndex((panel) => `#${panel.id}` === window.location.hash);
            if (nextIndex >= 0) void switchTo(nextIndex, false, false);
        });
    });

    type ProgrammeMediaEntry = {
        button: HTMLButtonElement;
        number: string;
        kicker: string;
        title: string;
        source: string;
        expectedBytes: number;
        duration: number;
        repeat: number;
        kind: 'audio' | 'video';
        aspect: 'landscape' | 'portrait' | 'audio';
        performer: string;
        credit: string;
        note: string;
        blob: Blob | null;
        objectUrl: string | null;
        origin: ConcertAudioAssetOrigin | null;
        state: 'loading' | 'ready' | 'failed';
    };

    const mediaDialog = document.querySelector<HTMLDialogElement>('[data-programme-media-dialog]');
    const mediaVideoPlayer = mediaDialog?.querySelector<HTMLVideoElement>('[data-programme-media-player="video"]');
    const mediaAudioPlayer = mediaDialog?.querySelector<HTMLAudioElement>('[data-programme-media-player="audio"]');
    const mediaAudioCard = mediaDialog?.querySelector<HTMLElement>('[data-programme-media-audio-card]');
    const mediaAudioTitle = mediaDialog?.querySelector<HTMLElement>('[data-programme-media-audio-title]');
    const mediaAudioPerformer = mediaDialog?.querySelector<HTMLElement>('[data-programme-media-audio-performer]');
    const mediaStage = mediaDialog?.querySelector<HTMLElement>('[data-programme-media-stage]');
    const mediaTitle = mediaDialog?.querySelector<HTMLElement>('[data-programme-media-title]');
    const mediaKicker = mediaDialog?.querySelector<HTMLElement>('[data-programme-media-kicker]');
    const mediaNotice = mediaDialog?.querySelector<HTMLElement>('[data-programme-media-notice]');
    const mediaCredit = mediaDialog?.querySelector<HTMLElement>('[data-programme-media-credit]');
    const mediaStatus = mediaDialog?.querySelector<HTMLElement>('[data-programme-media-status]');
    const mediaClose = mediaDialog?.querySelector<HTMLButtonElement>('[data-programme-media-close]');
    const mediaControls = mediaDialog?.querySelector<HTMLElement>('[data-programme-media-controls]');
    const mediaPlay = mediaDialog?.querySelector<HTMLButtonElement>('[data-programme-media-play]');
    const mediaSeek = mediaDialog?.querySelector<HTMLInputElement>('[data-programme-media-seek]');
    const mediaCurrent = mediaDialog?.querySelector<HTMLElement>('[data-programme-media-current]');
    const mediaDuration = mediaDialog?.querySelector<HTMLElement>('[data-programme-media-duration]');
    const mediaMute = mediaDialog?.querySelector<HTMLButtonElement>('[data-programme-media-mute]');
    const mediaVolume = mediaDialog?.querySelector<HTMLInputElement>('[data-programme-media-volume]');
    const mediaSettings = mediaDialog?.querySelector<HTMLElement>('[data-programme-media-settings]');
    const mediaSettingsToggle = mediaDialog?.querySelector<HTMLButtonElement>('[data-programme-media-settings-toggle]');
    const mediaSettingsPopover = mediaDialog?.querySelector<HTMLElement>('[data-programme-media-settings-popover]');
    const mediaFadeToggle = mediaDialog?.querySelector<HTMLButtonElement>('[data-programme-media-fade-toggle]');
    const mediaCacheToggle = mediaDialog?.querySelector<HTMLButtonElement>('[data-programme-media-cache-toggle]');
    const mediaCachePercent = mediaDialog?.querySelector<HTMLElement>('[data-programme-media-cache-percent]');
    const mediaCacheDetail = mediaDialog?.querySelector<HTMLElement>('[data-programme-media-cache-detail]');
    const mediaCachePopover = mediaDialog?.querySelector<HTMLElement>('[data-programme-media-cache-popover]');
    const mediaReload = mediaDialog?.querySelector<HTMLButtonElement>('[data-programme-media-reload]');
    const mediaFullscreen = mediaDialog?.querySelector<HTMLButtonElement>('[data-programme-media-fullscreen]');

    const mediaEntries: ProgrammeMediaEntry[] = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-programme-media-button]')).map((button) => ({
        button,
        number: button.dataset.mediaNumber || '',
        kicker: button.dataset.mediaKicker || 'Programme media',
        title: button.dataset.mediaTitle || '節目影片',
        source: button.dataset.mediaSource || '',
        expectedBytes: Number(button.dataset.mediaBytes || 0),
        duration: Number(button.dataset.mediaDuration || 0),
        repeat: Math.max(1, Number(button.dataset.mediaRepeat || 1)),
        kind: button.dataset.mediaKind === 'audio' ? 'audio' : 'video',
        aspect: button.dataset.mediaAspect === 'portrait' ? 'portrait' : button.dataset.mediaAspect === 'audio' ? 'audio' : 'landscape',
        performer: button.dataset.mediaPerformer || '',
        credit: button.dataset.mediaCredit || '',
        note: button.dataset.mediaNote || '',
        blob: null,
        objectUrl: null,
        origin: null,
        state: 'loading',
    }));

    if (
        mediaDialog && mediaVideoPlayer && mediaAudioPlayer && mediaAudioCard && mediaAudioTitle && mediaAudioPerformer
        && mediaStage && mediaTitle && mediaKicker && mediaNotice && mediaCredit
        && mediaStatus && mediaClose && mediaControls && mediaPlay && mediaSeek && mediaCurrent && mediaDuration
        && mediaMute && mediaVolume && mediaSettings && mediaSettingsToggle && mediaSettingsPopover && mediaFadeToggle
        && mediaCacheToggle && mediaCachePercent && mediaCacheDetail
        && mediaCachePopover && mediaReload && mediaFullscreen && mediaEntries.length
    ) {
        let mediaCache: ConcertAudioStore | null = null;
        let activeEntry: ProgrammeMediaEntry | null = null;
        let activePlayer: HTMLMediaElement | null = null;
        let completedLoops = 0;
        let isSeeking = false;
        let loopFadeEnabled = true;
        let repeatTimer: number | null = null;
        let fadeStateTimer: number | null = null;
        let audioContext: AudioContext | null = null;
        let audioSource: MediaElementAudioSourceNode | null = null;
        let audioGain: GainNode | null = null;
        const loopFadeSeconds = 1.4;

        const formatTime = (value: number) => {
            if (!Number.isFinite(value) || value < 0) return '0:00';
            const totalSeconds = Math.floor(value);
            const minutes = Math.floor(totalSeconds / 60);
            const seconds = String(totalSeconds % 60).padStart(2, '0');
            return `${minutes}:${seconds}`;
        };

        const updateRangeFill = (range: HTMLInputElement, value: number, max: number) => {
            const percent = max > 0 ? Math.min(100, Math.max(0, (value / max) * 100)) : 0;
            range.style.setProperty('--range-progress', `${percent}%`);
        };

        const renderPerformerNames = (value: string) => {
            const names = value.split('、').map((name) => name.trim()).filter(Boolean);
            mediaAudioPerformer.replaceChildren(...names.map((name, index) => {
                const token = document.createElement('span');
                token.textContent = index < names.length - 1 ? `${name}、` : name;
                return token;
            }));
        };

        const fadeApplies = () => Boolean(
            loopFadeEnabled
            && activeEntry?.kind === 'audio'
            && activeEntry.repeat > 1
            && completedLoops < activeEntry.repeat - 1
            && activePlayer === mediaAudioPlayer
        );

        const syncFadeSetting = () => {
            mediaFadeToggle.setAttribute('aria-checked', loopFadeEnabled ? 'true' : 'false');
            mediaControls.dataset.loopFade = loopFadeEnabled ? 'true' : 'false';
        };

        const ensureAudioGraph = async () => {
            if (!audioContext) {
                audioContext = new AudioContext();
                audioSource = audioContext.createMediaElementSource(mediaAudioPlayer);
                audioGain = audioContext.createGain();
                audioSource.connect(audioGain).connect(audioContext.destination);
            }
            if (audioContext.state === 'suspended') await audioContext.resume();
        };

        const resetLoopGain = () => {
            if (fadeStateTimer !== null) window.clearTimeout(fadeStateTimer);
            fadeStateTimer = null;
            mediaControls.dataset.fadeState = 'idle';
            if (!audioContext || !audioGain) return;
            const now = audioContext.currentTime;
            audioGain.gain.cancelScheduledValues(now);
            audioGain.gain.setValueAtTime(1, now);
        };

        const scheduleLoopFade = async () => {
            resetLoopGain();
            if (!fadeApplies() || !activePlayer || activePlayer.paused) return;

            try {
                await ensureAudioGraph();
            } catch {
                loopFadeEnabled = false;
                syncFadeSetting();
                mediaStatus.textContent = '此瀏覽器無法啟用循環淡出，將以一般方式播放';
                return;
            }

            if (!audioContext || !audioGain || !Number.isFinite(activePlayer.duration)) return;
            const remaining = Math.max(0, activePlayer.duration - activePlayer.currentTime);
            if (remaining <= 0) return;
            const duration = Math.min(loopFadeSeconds, remaining);
            const now = audioContext.currentTime;
            const fadeStartsIn = Math.max(0, remaining - duration);
            audioGain.gain.cancelScheduledValues(now);
            audioGain.gain.setValueAtTime(1, now);
            audioGain.gain.setValueAtTime(1, now + fadeStartsIn);
            audioGain.gain.linearRampToValueAtTime(0.0001, now + remaining);
            mediaControls.dataset.fadeState = 'scheduled';
            fadeStateTimer = window.setTimeout(() => {
                if (fadeApplies() && activePlayer && !activePlayer.paused) mediaControls.dataset.fadeState = 'fading';
            }, fadeStartsIn * 1000);
        };

        const updateCacheDisplay = (entry: ProgrammeMediaEntry, percent: number, state: ProgrammeMediaEntry['state']) => {
            if (activeEntry !== entry) return;
            const safePercent = Math.min(100, Math.max(0, Math.round(percent)));
            mediaControls.dataset.cacheState = state;
            mediaCacheToggle.style.setProperty('--cache-progress', String(safePercent));
            mediaCachePercent.textContent = state === 'failed' ? '!' : String(safePercent);
            mediaCacheDetail.textContent = state === 'failed' ? '載入失敗' : `${safePercent}%`;
            mediaReload.disabled = state === 'loading';
            const mediaUnavailable = state !== 'ready';
            mediaPlay.disabled = mediaUnavailable;
            mediaSeek.disabled = mediaUnavailable;
            mediaMute.disabled = mediaUnavailable;
            mediaVolume.disabled = mediaUnavailable;
            mediaCacheToggle.setAttribute('aria-label', state === 'ready'
                ? '快取已就緒，開啟快取選項'
                : state === 'failed'
                    ? '快取載入失敗，開啟快取選項'
                    : `快取載入中 ${safePercent}%`);
        };

        const syncPlayerControls = () => {
            if (!activePlayer) return;
            const duration = Number.isFinite(activePlayer.duration) ? activePlayer.duration : activeEntry?.duration ?? 0;
            const currentTime = Number.isFinite(activePlayer.currentTime) ? activePlayer.currentTime : 0;
            mediaControls.dataset.playing = activePlayer.paused ? 'false' : 'true';
            mediaPlay.setAttribute('aria-label', activePlayer.paused ? '播放' : '暫停');
            mediaSeek.max = String(Math.max(duration, 1));
            if (!isSeeking) mediaSeek.value = String(currentTime);
            mediaCurrent.textContent = formatTime(currentTime);
            mediaDuration.textContent = formatTime(duration);
            updateRangeFill(mediaSeek, Number(mediaSeek.value), Number(mediaSeek.max));
            mediaVolume.value = String(activePlayer.muted ? 0 : activePlayer.volume);
            updateRangeFill(mediaVolume, Number(mediaVolume.value), 1);
            mediaControls.dataset.muted = activePlayer.muted || activePlayer.volume === 0 ? 'true' : 'false';
            mediaMute.setAttribute('aria-label', activePlayer.muted || activePlayer.volume === 0 ? '取消靜音' : '靜音');
        };

        const syncFullscreenControl = () => {
            const isFullscreen = document.fullscreenElement === mediaStage;
            mediaStage.dataset.fullscreen = isFullscreen ? 'true' : 'false';
            mediaFullscreen.setAttribute('aria-label', isFullscreen ? '退出全螢幕' : '進入全螢幕');
            mediaFullscreen.setAttribute('aria-pressed', isFullscreen ? 'true' : 'false');
        };

        const togglePlayback = async () => {
            if (!activePlayer || activeEntry?.state !== 'ready') return;
            try {
                if (activePlayer.paused) {
                    if (fadeApplies()) {
                        try {
                            await ensureAudioGraph();
                        } catch {
                            loopFadeEnabled = false;
                            syncFadeSetting();
                            mediaStatus.textContent = '此瀏覽器無法啟用循環淡出，將以一般方式播放';
                        }
                    }
                    await activePlayer.play();
                    await scheduleLoopFade();
                } else {
                    activePlayer.pause();
                    resetLoopGain();
                }
            } catch {
                mediaStatus.textContent = '無法開始播放，請再試一次';
            }
        };

        const toggleFullscreen = async () => {
            try {
                if (document.fullscreenElement === mediaStage) await document.exitFullscreen();
                else await mediaStage.requestFullscreen();
            } catch {
                mediaStatus.textContent = '此瀏覽器無法切換全螢幕';
            }
        };

        const updateMediaButton = (entry: ProgrammeMediaEntry, loadedBytes: number, state: ProgrammeMediaEntry['state']) => {
            const percent = entry.expectedBytes > 0
                ? Math.min(100, Math.round((Math.max(0, loadedBytes) / entry.expectedBytes) * 100))
                : 0;
            entry.state = state;
            entry.button.dataset.state = state;
            entry.button.style.setProperty('--programme-media-progress', String(percent));
            const percentLabel = entry.button.querySelector<HTMLElement>('[data-programme-media-percent]');
            if (percentLabel) percentLabel.textContent = state === 'failed' ? '!' : String(percent);
            updateCacheDisplay(entry, percent, state);
            entry.button.disabled = state === 'loading';
            const kindLabel = entry.kind === 'audio' ? '音訊' : '影片';
            entry.button.setAttribute('aria-label', state === 'ready'
                ? `播放 ${entry.kicker}：${entry.title}${kindLabel}，已完整載入`
                : state === 'failed'
                    ? `${entry.kicker}：${entry.title}${kindLabel}載入失敗，按下重新載入`
                    : `${entry.kicker}：${entry.title}${kindLabel}載入中 ${percent}%`);
        };

        const loadMediaEntry = async (entry: ProgrammeMediaEntry, forceNetwork = false) => {
            updateMediaButton(entry, 0, 'loading');
            try {
                const result = await loadConcertProgrammeMediaAsset({
                    source: entry.source,
                    expectedBytes: entry.expectedBytes,
                    cache: mediaCache,
                    forceNetwork,
                    onProgress: (loadedBytes) => updateMediaButton(entry, loadedBytes, 'loading'),
                });
                entry.blob = result.blob;
                entry.origin = result.origin;
                updateMediaButton(entry, entry.expectedBytes, 'ready');
            } catch {
                entry.blob = null;
                entry.origin = null;
                updateMediaButton(entry, 0, 'failed');
            }
        };

        const prepareProgrammeMedia = async () => {
            if ('storage' in navigator && typeof navigator.storage.persist === 'function') {
                void navigator.storage.persist().catch(() => false);
            }
            mediaCache = await openConcertProgrammeMediaCache();
            for (const entry of mediaEntries) await loadMediaEntry(entry);
        };

        const closeMedia = () => {
            if (document.fullscreenElement === mediaStage) void document.exitFullscreen();
            [mediaVideoPlayer, mediaAudioPlayer].forEach((player) => {
                player.pause();
                player.removeAttribute('src');
                player.load();
                delete player.dataset.active;
            });
            activePlayer = null;
            activeEntry = null;
            completedLoops = 0;
            if (repeatTimer !== null) window.clearTimeout(repeatTimer);
            repeatTimer = null;
            resetLoopGain();
            mediaSettingsPopover.hidden = true;
            mediaSettingsToggle.setAttribute('aria-expanded', 'false');
            mediaCachePopover.hidden = true;
            mediaCacheToggle.setAttribute('aria-expanded', 'false');
            document.body.classList.remove('is-concert-media-open');
            if (mediaDialog.open) mediaDialog.close();
        };

        const openMedia = async (entry: ProgrammeMediaEntry) => {
            if (entry.state === 'failed') {
                await loadMediaEntry(entry, true);
                if (entry.state !== 'ready') return;
            }
            if (!entry.blob || entry.state !== 'ready') return;

            if (!entry.objectUrl) entry.objectUrl = URL.createObjectURL(entry.blob);
            activeEntry = entry;
            completedLoops = 0;
            mediaTitle.textContent = entry.title;
            mediaKicker.textContent = entry.kicker;
            mediaNotice.textContent = entry.note;
            mediaNotice.hidden = !entry.note;
            mediaCredit.textContent = entry.credit;
            mediaDialog.dataset.kind = entry.kind;
            mediaStage.dataset.aspect = entry.aspect;
            mediaStage.dataset.kind = entry.kind;
            mediaAudioTitle.textContent = entry.title;
            renderPerformerNames(entry.performer);
            mediaAudioCard.hidden = entry.kind !== 'audio';
            mediaVideoPlayer.hidden = entry.kind !== 'video';
            mediaAudioPlayer.hidden = entry.kind !== 'audio';
            mediaStatus.textContent = entry.repeat > 1 ? `準備連續播放 ${entry.repeat} 次` : `${entry.title}已準備播放`;
            activePlayer = entry.kind === 'audio' ? mediaAudioPlayer : mediaVideoPlayer;
            activePlayer.dataset.active = 'true';
            activePlayer.pause();
            activePlayer.autoplay = false;
            activePlayer.src = entry.objectUrl;
            activePlayer.volume = 1;
            activePlayer.muted = false;
            activePlayer.load();
            activePlayer.currentTime = 0;
            mediaSeek.value = '0';
            const hasSettings = entry.kind === 'audio' && entry.repeat > 1;
            mediaSettings.hidden = !hasSettings;
            mediaControls.dataset.hasSettings = hasSettings ? 'true' : 'false';
            mediaSettingsPopover.hidden = true;
            mediaSettingsToggle.setAttribute('aria-expanded', 'false');
            syncFadeSetting();
            mediaCachePopover.hidden = true;
            mediaCacheToggle.setAttribute('aria-expanded', 'false');
            updateCacheDisplay(entry, 100, 'ready');
            syncPlayerControls();
            document.body.classList.add('is-concert-media-open');
            mediaDialog.showModal();
            requestAnimationFrame(() => mediaPlay.focus());
        };

        const reloadActiveMedia = async () => {
            const entry = activeEntry;
            const player = activePlayer;
            if (!entry || !player || entry.state === 'loading') return;

            player.pause();
            mediaControls.dataset.reloading = 'true';
            mediaCachePopover.hidden = true;
            mediaCacheToggle.setAttribute('aria-expanded', 'false');
            mediaStatus.textContent = `${entry.title}正在重新載入`;

            if (entry.objectUrl) {
                URL.revokeObjectURL(entry.objectUrl);
                entry.objectUrl = null;
            }
            player.removeAttribute('src');
            player.load();
            await mediaCache?.delete(entry.source).catch(() => false);
            await loadMediaEntry(entry, true);

            if (entry.state !== 'ready' || !entry.blob || activeEntry !== entry) {
                delete mediaControls.dataset.reloading;
                mediaStatus.textContent = `${entry.title}載入失敗，請開啟快取選項後再試一次`;
                return;
            }

            entry.objectUrl = URL.createObjectURL(entry.blob);
            player.src = entry.objectUrl;
            player.currentTime = 0;
            player.load();
            syncPlayerControls();
            delete mediaControls.dataset.reloading;
            mediaStatus.textContent = `${entry.title}已重新載入`;
        };

        mediaEntries.forEach((entry) => {
            updateMediaButton(entry, 0, 'loading');
            entry.button.addEventListener('click', () => void openMedia(entry));
        });

        [mediaVideoPlayer, mediaAudioPlayer].forEach((player) => {
            ['loadedmetadata', 'durationchange', 'timeupdate', 'play', 'pause', 'volumechange'].forEach((eventName) => {
                player.addEventListener(eventName, syncPlayerControls);
            });
        });

        mediaPlay.addEventListener('click', () => void togglePlayback());
        mediaSeek.addEventListener('pointerdown', () => { isSeeking = true; });
        mediaSeek.addEventListener('input', () => {
            if (!activePlayer) return;
            const nextTime = Number(mediaSeek.value);
            activePlayer.currentTime = nextTime;
            mediaCurrent.textContent = formatTime(nextTime);
            updateRangeFill(mediaSeek, nextTime, Number(mediaSeek.max));
        });
        mediaSeek.addEventListener('change', () => {
            isSeeking = false;
            syncPlayerControls();
            void scheduleLoopFade();
        });
        mediaSeek.addEventListener('pointerup', () => {
            isSeeking = false;
            syncPlayerControls();
            void scheduleLoopFade();
        });
        mediaMute.addEventListener('click', () => {
            if (!activePlayer) return;
            activePlayer.muted = !activePlayer.muted;
        });
        mediaVolume.addEventListener('input', () => {
            if (!activePlayer) return;
            activePlayer.volume = Number(mediaVolume.value);
            activePlayer.muted = activePlayer.volume === 0;
        });
        mediaSettingsToggle.addEventListener('click', () => {
            const expanded = mediaSettingsToggle.getAttribute('aria-expanded') === 'true';
            mediaSettingsToggle.setAttribute('aria-expanded', expanded ? 'false' : 'true');
            mediaSettingsPopover.hidden = expanded;
            mediaCachePopover.hidden = true;
            mediaCacheToggle.setAttribute('aria-expanded', 'false');
        });
        mediaFadeToggle.addEventListener('click', () => {
            loopFadeEnabled = !loopFadeEnabled;
            syncFadeSetting();
            if (loopFadeEnabled) void scheduleLoopFade();
            else resetLoopGain();
        });
        mediaCacheToggle.addEventListener('click', () => {
            const expanded = mediaCacheToggle.getAttribute('aria-expanded') === 'true';
            mediaCacheToggle.setAttribute('aria-expanded', expanded ? 'false' : 'true');
            mediaCachePopover.hidden = expanded;
            mediaSettingsPopover.hidden = true;
            mediaSettingsToggle.setAttribute('aria-expanded', 'false');
        });
        mediaReload.addEventListener('click', () => void reloadActiveMedia());
        mediaFullscreen.addEventListener('click', () => void toggleFullscreen());
        document.addEventListener('fullscreenchange', syncFullscreenControl);

        mediaVideoPlayer.addEventListener('click', () => void togglePlayback());
        mediaDialog.addEventListener('keydown', (event) => {
            if ((event.target as HTMLElement).closest('button, input')) return;
            if (event.key === ' ' || event.key.toLowerCase() === 'k') {
                event.preventDefault();
                void togglePlayback();
            }
            if (event.key === 'ArrowLeft' && activePlayer) {
                activePlayer.currentTime = Math.max(0, activePlayer.currentTime - 5);
            }
            if (event.key === 'ArrowRight' && activePlayer) {
                activePlayer.currentTime = Math.min(activePlayer.duration || Infinity, activePlayer.currentTime + 5);
            }
            if (event.key.toLowerCase() === 'm' && activePlayer) activePlayer.muted = !activePlayer.muted;
            if (event.key.toLowerCase() === 'f') void toggleFullscreen();
        });

        const handleMediaEnded = () => {
            if (!activeEntry) return;
            resetLoopGain();
            completedLoops += 1;
            if (completedLoops < activeEntry.repeat) {
                mediaStatus.textContent = `自動播放 ${activeEntry.repeat} 次 · 第 ${completedLoops + 1} 次`;
                if (activePlayer) {
                    const loopEntry = activeEntry;
                    const loopPlayer = activePlayer;
                    loopPlayer.currentTime = 0;
                    repeatTimer = window.setTimeout(() => {
                        repeatTimer = null;
                        if (activeEntry !== loopEntry || activePlayer !== loopPlayer) return;
                        void loopPlayer.play().then(() => scheduleLoopFade()).catch(() => {
                            mediaStatus.textContent = '第二次播放無法開始，請按播放鍵再試一次';
                        });
                    }, loopFadeEnabled ? 140 : 0);
                }
                return;
            }
            mediaStatus.textContent = activeEntry.repeat > 1
                ? `已完成 ${activeEntry.repeat} 次播放`
                : '影片播放完畢';
        };
        mediaVideoPlayer.addEventListener('ended', handleMediaEnded);
        mediaAudioPlayer.addEventListener('ended', handleMediaEnded);

        mediaClose.addEventListener('click', closeMedia);
        mediaDialog.addEventListener('cancel', (event) => {
            event.preventDefault();
            closeMedia();
        });
        mediaDialog.addEventListener('click', (event) => {
            if (event.target === mediaDialog) closeMedia();
            if (!mediaSettingsToggle.contains(event.target as Node) && !mediaSettingsPopover.contains(event.target as Node)) {
                mediaSettingsPopover.hidden = true;
                mediaSettingsToggle.setAttribute('aria-expanded', 'false');
            }
            if (!mediaCacheToggle.contains(event.target as Node) && !mediaCachePopover.contains(event.target as Node)) {
                mediaCachePopover.hidden = true;
                mediaCacheToggle.setAttribute('aria-expanded', 'false');
            }
        });
        window.addEventListener('beforeunload', () => {
            mediaEntries.forEach((entry) => {
                if (entry.objectUrl) URL.revokeObjectURL(entry.objectUrl);
            });
        });

        void prepareProgrammeMedia();
    }
</script>
