---
import { concert2026 } from '../../data/concert-2026';
---

<section class="concert-hero" aria-labelledby="concert-title">
    <picture class="concert-hero__art" aria-hidden="true">
        <source media="(max-width: 720px)" srcset="/concert/2026/poster-sakura.webp?v=20260828c" />
        <img
            src="/concert/2026/stage-sakura.webp?v=20260828c"
            alt=""
            width="1672"
            height="941"
            fetchpriority="high"
        />
    </picture>
    <div id="concert-stage-motion" class="concert-stage-motion" aria-hidden="true">
        <video
            class="concert-stage-video concert-stage-video--primary"
            data-concert-stage-video
            data-stage-layer="primary"
            data-stage-active="true"
            data-src="/concert/2026/stage-sakura-omni-natural-720p.mp4?v=20260828d"
            data-src-uhd="/concert/2026/stage-sakura-omni-natural-4k.mp4?v=20260828d"
            data-poster="/concert/2026/stage-sakura-poster-4k.webp?v=20260828d"
            width="1280"
            height="720"
            preload="auto"
            muted
            playsinline
        ></video>
        <video
            class="concert-stage-video concert-stage-video--secondary"
            data-concert-stage-video
            data-stage-layer="secondary"
            data-stage-active="false"
            width="1280"
            height="720"
            preload="auto"
            muted
            playsinline
        ></video>
    </div>
    <div class="concert-hero__veil" aria-hidden="true"></div>
    <div class="concert-stage-ambient" aria-hidden="true"></div>
    <canvas class="concert-stage-effects" data-concert-stage-canvas aria-hidden="true"></canvas>

    <div class="concert-shell concert-hero__inner">
        <div class="concert-hero__copy">
            <p class="concert-eyebrow">Hand in hand · music brings us together</p>
            <p class="concert-hero__kicker">{concert2026.title}</p>
            <div class="concert-rule" aria-hidden="true"></div>
            <h1 id="concert-title">{concert2026.theme}</h1>
            <p class="concert-hero__theme-line">{concert2026.themeLine}</p>

            <dl class="concert-hero__facts" aria-label="音樂會資訊">
                <div>
                    <dt>Date · Time</dt>
                    <dd>
                        <time datetime={concert2026.dateTime}>{concert2026.dateLabel}　{concert2026.time}</time>
                    </dd>
                </div>
                <div>
                    <dt>Venue</dt>
                    <dd>{concert2026.venue}</dd>
                </div>
            </dl>

            <div class="concert-hero__actions">
                <a class="concert-button concert-button--primary" href="#programme">查看完整節目表</a>
                <a class="concert-button concert-button--ghost" href="#lyrics">大合唱</a>
                <a class="concert-button concert-button--ghost" href="#gratitude">閱讀老師的話</a>
            </div>
        </div>
    </div>

    <a class="concert-hero__scroll" href="#programme" aria-label="前往完整節目表">
        <span>Scroll to programme</span>
        <span class="concert-hero__scroll-line" aria-hidden="true"></span>
    </a>

    <div class="concert-hero__media-controls" data-hero-media-controls aria-label="主視覺控制">
        <button type="button" data-stage-pause aria-pressed="false" aria-controls="concert-stage-motion">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path class="concert-media-icon--play" d="m9 7 8 5-8 5Z" />
                <path class="concert-media-icon--pause" d="M9 7v10M15 7v10" />
            </svg>
            <span class="sr-only">播放背景</span>
        </button>
        <button type="button" data-stage-fullscreen aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5" /></svg>
            <span class="sr-only">全螢幕</span>
        </button>
        <p class="sr-only" data-stage-status aria-live="polite"></p>
    </div>
</section>

<script>
    const html = document.documentElement;
    const legacyStage = html.dataset.concertStage === 'true';
    {
        const canvas = document.querySelector<HTMLCanvasElement>('[data-concert-stage-canvas]');
        const hero = document.querySelector<HTMLElement>('.concert-hero');
        const stageVideos = Array.from(document.querySelectorAll<HTMLVideoElement>('[data-concert-stage-video]'));
        const stageVideo = stageVideos[0];
        const fullscreenButton = document.querySelector<HTMLButtonElement>('[data-stage-fullscreen]');
        const pauseButton = document.querySelector<HTMLButtonElement>('[data-stage-pause]');
        const status = document.querySelector<HTMLElement>('[data-stage-status]');
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        let paused = !legacyStage || reducedMotion.matches;
        let mediaInitialized = false;
        let frame = 0;
        let lastTime = performance.now();
        let lastPaint = 0;
        let resumeStageVideos: (() => void) | null = null;
        let disposeStageCrossfade: (() => void) | null = null;
        let wakeLock: { release: () => Promise<void> } | null = null;

        html.dataset.stagePaused = String(paused);
        html.dataset.heroMotion = paused ? 'paused' : 'playing';
        html.dataset.stageReducedMotion = String(reducedMotion.matches);

        const announce = (message: string) => {
            if (status) status.textContent = message;
        };

        const smoothstep = (edgeStart: number, edgeEnd: number, value: number) => {
            const progress = Math.min(1, Math.max(0, (value - edgeStart) / (edgeEnd - edgeStart)));
            return progress * progress * (3 - 2 * progress);
        };

        const setPaused = (nextPaused: boolean) => {
            paused = nextPaused;
            html.dataset.stagePaused = String(paused);
            html.dataset.heroMotion = paused ? 'paused' : 'playing';
            if (paused) stageVideos.forEach((video) => video.pause());
            else {
                initializeStageMedia();
                resumeStageVideos?.();
            }
            pauseButton?.setAttribute('aria-pressed', String(!paused));
            const label = pauseButton?.querySelector('span');
            if (label) label.textContent = paused ? '播放背景' : '暫停背景';
            announce(paused ? '背景影片已暫停，顯示靜態主視覺' : '背景影片開始播放');
        };

        const updateFullscreenLabel = () => {
            const label = fullscreenButton?.querySelector('span');
            const isHeroFullscreen = document.fullscreenElement === hero;
            fullscreenButton?.setAttribute('aria-pressed', String(isHeroFullscreen));
            html.dataset.heroFullscreen = String(isHeroFullscreen);
            if (label) label.textContent = isHeroFullscreen ? '離開全螢幕' : '全螢幕';
            if (!isHeroFullscreen && wakeLock) {
                wakeLock.release().catch(() => undefined);
                wakeLock = null;
            }
        };

        const toggleFullscreen = async () => {
            try {
                if (document.fullscreenElement) {
                    await document.exitFullscreen();
                } else if (hero) {
                    await hero.requestFullscreen();
                    if ('wakeLock' in navigator) {
                        wakeLock = await navigator.wakeLock.request('screen');
                    }
                }
                updateFullscreenLabel();
            } catch {
                announce('瀏覽器未允許全螢幕，請使用瀏覽器選單開啟');
            }
        };

        fullscreenButton?.addEventListener('click', toggleFullscreen);
        pauseButton?.addEventListener('click', () => setPaused(!paused));
        document.addEventListener('fullscreenchange', updateFullscreenLabel);
        document.addEventListener('keydown', (event) => {
            const target = event.target;
            if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement) return;
            const controlsHero = document.fullscreenElement === hero || legacyStage;
            if (controlsHero && event.key.toLowerCase() === 'f') {
                event.preventDefault();
                toggleFullscreen();
            }
            if (controlsHero && event.code === 'Space') {
                event.preventDefault();
                setPaused(!paused);
            }
        });

        reducedMotion.addEventListener('change', ({ matches }) => {
            html.dataset.stageReducedMotion = String(matches);
            if (matches) setPaused(true);
        });

        const initializeStageMedia = () => {
            if (mediaInitialized || !stageVideo?.dataset.src || stageVideos.length !== 2) return;
            mediaInitialized = true;
            html.dataset.heroMediaInitialized = 'true';
            if (stageVideo.dataset.poster) stageVideo.poster = stageVideo.dataset.poster;
            const overlapSeconds = 1;
            let activeIndex = 0;
            let crossfading = false;
            let crossfadeFrame = 0;
            let loopCount = 0;
            let stallCount = 0;
            let totalWaitMs = 0;
            let maxWaitMs = 0;
            let disposed = false;
            const waitingStartedAt = new WeakMap<HTMLVideoElement, number>();
            const displayPixels = Math.max(window.innerWidth, window.screen.width) * (window.devicePixelRatio || 1);
            const selectedSource = displayPixels >= 2800 && stageVideo.dataset.srcUhd
                ? stageVideo.dataset.srcUhd
                : stageVideo.dataset.src;

            const setLayerState = (video: HTMLVideoElement, active: boolean, opacity: number) => {
                video.dataset.stageActive = String(active);
                video.style.opacity = opacity.toFixed(3);
                video.style.zIndex = active ? '1' : '0';
            };

            const completeCrossfade = () => {
                if (!crossfading) return;
                const outgoing = stageVideos[activeIndex];
                const incomingIndex = activeIndex === 0 ? 1 : 0;
                const incoming = stageVideos[incomingIndex];
                outgoing.pause();
                outgoing.currentTime = 0;
                setLayerState(outgoing, false, 0);
                setLayerState(incoming, true, 1);
                activeIndex = incomingIndex;
                crossfading = false;
                loopCount += 1;
                html.dataset.stageLoopCount = String(loopCount);
                html.dataset.stageCrossfadeProgress = '0';
                html.dataset.stageActiveLayer = incoming.dataset.stageLayer ?? String(incomingIndex);
                html.dataset.stageConcurrentVideos = '1';
            };

            const renderCrossfade = () => {
                if (disposed) return;
                if (!paused) {
                    const outgoing = stageVideos[activeIndex];
                    const incomingIndex = activeIndex === 0 ? 1 : 0;
                    const incoming = stageVideos[incomingIndex];
                    const duration = outgoing.duration;
                    if (Number.isFinite(duration) && duration > overlapSeconds + 1) {
                        const transitionStart = duration - overlapSeconds;
                        if (!crossfading && outgoing.currentTime >= transitionStart) {
                            crossfading = true;
                            incoming.currentTime = 0;
                            setLayerState(incoming, false, 0);
                            incoming.play().catch(() => announce('影片等待瀏覽器允許播放'));
                            html.dataset.stageConcurrentVideos = '2';
                        }
                        if (crossfading) {
                            const rawProgress = Math.min(1, Math.max(0, (outgoing.currentTime - transitionStart) / overlapSeconds));
                            const easedProgress = smoothstep(0, 1, rawProgress);
                            // Keep the outgoing layer fully opaque while the incoming layer rises
                            // above it. This produces a true dissolve without revealing the poster
                            // or page background at the midpoint.
                            outgoing.style.opacity = '1';
                            incoming.style.opacity = easedProgress.toFixed(3);
                            incoming.style.zIndex = '1';
                            outgoing.style.zIndex = '0';
                            html.dataset.stageCrossfadeProgress = easedProgress.toFixed(3);
                            if (rawProgress >= 0.995 || outgoing.ended) completeCrossfade();
                        }
                    }
                }
                crossfadeFrame = window.requestAnimationFrame(renderCrossfade);
            };

            resumeStageVideos = () => {
                const active = stageVideos[activeIndex];
                active.play().catch(() => announce('影片等待瀏覽器允許播放'));
                if (crossfading) {
                    const incoming = stageVideos[activeIndex === 0 ? 1 : 0];
                    incoming.play().catch(() => announce('影片等待瀏覽器允許播放'));
                }
            };

            const readyVideos = new Set<HTMLVideoElement>();
            const markReady = (video: HTMLVideoElement) => {
                readyVideos.add(video);
                if (readyVideos.size !== stageVideos.length) return;
                setLayerState(stageVideos[0], true, 1);
                setLayerState(stageVideos[1], false, 0);
                html.dataset.stageVideoReady = 'true';
                html.dataset.stageActiveLayer = stageVideos[0].dataset.stageLayer ?? 'primary';
                html.dataset.stageConcurrentVideos = '1';
                if (!paused) resumeStageVideos?.();
                crossfadeFrame = window.requestAnimationFrame(renderCrossfade);
            };

            stageVideos.forEach((video) => {
                video.dataset.selectedSource = selectedSource;
                video.src = selectedSource;
                video.addEventListener('canplay', () => markReady(video), { once: true });
                video.addEventListener('waiting', () => {
                    if (html.dataset.stageVideoReady !== 'true') return;
                    stallCount += 1;
                    waitingStartedAt.set(video, performance.now());
                    html.dataset.stageStallCount = String(stallCount);
                    html.dataset.stageVideoBuffering = 'true';
                });
                video.addEventListener('playing', () => {
                    const startedAt = waitingStartedAt.get(video);
                    if (startedAt) {
                        const waitMs = performance.now() - startedAt;
                        totalWaitMs += waitMs;
                        maxWaitMs = Math.max(maxWaitMs, waitMs);
                        html.dataset.stageTotalWaitMs = String(Math.round(totalWaitMs));
                        html.dataset.stageMaxWaitMs = String(Math.round(maxWaitMs));
                        waitingStartedAt.delete(video);
                    }
                    delete html.dataset.stageVideoBuffering;
                });
                video.load();
            });
            html.dataset.stageLoopCount = '0';
            html.dataset.stageStallCount = '0';
            html.dataset.stageTotalWaitMs = '0';
            html.dataset.stageMaxWaitMs = '0';
            html.dataset.stageOverlapSeconds = String(overlapSeconds);
            html.dataset.stageCrossfadeProgress = '0';

            disposeStageCrossfade = () => {
                disposed = true;
                window.cancelAnimationFrame(crossfadeFrame);
                stageVideos.forEach((video) => video.pause());
            };
        };

        if (legacyStage) setPaused(paused);
        updateFullscreenLabel();

        type Petal = {
            x: number;
            y: number;
            size: number;
            speed: number;
            drift: number;
            phase: number;
            rotation: number;
            spin: number;
            opacity: number;
            note: boolean;
        };

        const petals: Petal[] = [];
        let width = 0;
        let height = 0;
        let context: CanvasRenderingContext2D | null = null;
        let seed = 20260829;
        const random = () => {
            seed = (seed * 1664525 + 1013904223) >>> 0;
            return seed / 4294967296;
        };

        const resetPetal = (petal: Petal, initial = false) => {
            petal.x = random() * width;
            petal.y = initial ? random() * height : -24 - random() * height * 0.16;
            petal.size = 3.5 + random() * 7.5;
            petal.speed = 8 + random() * 17;
            petal.drift = 10 + random() * 24;
            petal.phase = random() * Math.PI * 2;
            petal.rotation = random() * Math.PI * 2;
            petal.spin = (random() - 0.5) * 0.7;
            petal.opacity = 0.18 + random() * 0.42;
        };

        const resizeCanvas = () => {
            if (!canvas || !hero) return;
            const rect = hero.getBoundingClientRect();
            width = Math.max(1, rect.width);
            height = Math.max(1, rect.height);
            const dpr = Math.min(window.devicePixelRatio || 1, 1.25);
            canvas.width = Math.round(width * dpr);
            canvas.height = Math.round(height * dpr);
            canvas.style.width = `${width}px`;
            canvas.style.height = `${height}px`;
            context = canvas.getContext('2d');
            context?.setTransform(dpr, 0, 0, dpr, 0, 0);
            const desiredCount = Math.max(20, Math.min(42, Math.round(width / 42)));
            while (petals.length < desiredCount) {
                const petal: Petal = { x: 0, y: 0, size: 0, speed: 0, drift: 0, phase: 0, rotation: 0, spin: 0, opacity: 0, note: petals.length % 13 === 0 };
                resetPetal(petal, true);
                petals.push(petal);
            }
            petals.length = desiredCount;
            canvas.dataset.petalCount = String(petals.length);
            canvas.dataset.renderScale = String(dpr);
        };

        const drawPetal = (ctx: CanvasRenderingContext2D, petal: Petal) => {
            ctx.save();
            ctx.translate(petal.x, petal.y);
            ctx.rotate(petal.rotation);
            if (petal.note) {
                ctx.globalAlpha = Math.min(0.24, petal.opacity * 0.55);
                ctx.fillStyle = '#8e6536';
                ctx.beginPath();
                ctx.ellipse(0, petal.size * 0.55, petal.size * 0.46, petal.size * 0.31, -0.32, 0, Math.PI * 2);
                ctx.fill();
                ctx.fillRect(petal.size * 0.34, -petal.size * 1.15, Math.max(1, petal.size * 0.13), petal.size * 1.75);
            } else {
                ctx.globalAlpha = petal.opacity;
                ctx.fillStyle = petal.size > 7 ? '#f0cdcc' : '#fff7f2';
                ctx.beginPath();
                ctx.moveTo(0, -petal.size);
                ctx.bezierCurveTo(petal.size * 0.72, -petal.size * 0.34, petal.size * 0.62, petal.size * 0.62, 0, petal.size);
                ctx.bezierCurveTo(-petal.size * 0.62, petal.size * 0.62, -petal.size * 0.72, -petal.size * 0.34, 0, -petal.size);
                ctx.fill();
            }
            ctx.restore();
        };

        const render = (time: number) => {
            if (!context) return;
            if (time - lastPaint < 32 || (paused && lastPaint > 0) || document.hidden) {
                frame = window.requestAnimationFrame(render);
                return;
            }
            const delta = Math.min(0.05, (time - lastTime) / 1000);
            lastTime = time;
            lastPaint = time;
            context.clearRect(0, 0, width, height);

            petals.forEach((petal) => {
                if (!paused) {
                    petal.y += petal.speed * delta;
                    petal.x += Math.sin(time * 0.00042 + petal.phase) * petal.drift * delta;
                    petal.rotation += petal.spin * delta;
                    if (petal.y > height + 28 || petal.x < -40 || petal.x > width + 40) resetPetal(petal);
                }
                drawPetal(context!, petal);
            });
            frame = window.requestAnimationFrame(render);
        };

        if (legacyStage) {
            resizeCanvas();
            window.addEventListener('resize', resizeCanvas, { passive: true });
            frame = window.requestAnimationFrame(render);
        }

        window.addEventListener('pagehide', () => {
            window.cancelAnimationFrame(frame);
            disposeStageCrossfade?.();
            wakeLock?.release().catch(() => undefined);
        }, { once: true });
    }
</script>
