<script>
  const homeMotionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
  const homeAbout = document.querySelector<HTMLElement>('.home-about');
  const homeScrollCue = document.querySelector<HTMLElement>('.home-scroll-cue');
  let homeAboutObserver: IntersectionObserver | undefined;

  const revealHomeAbout = () => {
    if (!homeAbout) return;
    homeAbout.dataset.homeReveal = 'visible';
    homeAboutObserver?.disconnect();
    homeAboutObserver = undefined;
  };

  if (homeMotionPreference.matches || !('IntersectionObserver' in window)) {
    revealHomeAbout();
  } else if (homeAbout) {
    homeAboutObserver = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) revealHomeAbout();
    }, { threshold: 0.18, rootMargin: '0px 0px -10% 0px' });
    homeAboutObserver.observe(homeAbout);
  }

  const dismissHomeScrollCue = () => {
    if (!homeScrollCue) return;
    if (window.scrollY > 12) {
      homeScrollCue.dataset.dismissed = 'true';
    } else {
      delete homeScrollCue.dataset.dismissed;
    }
  };
  window.addEventListener('scroll', dismissHomeScrollCue, { passive: true });
  dismissHomeScrollCue();

  const handleHomeMotionPreference = (event: MediaQueryListEvent) => {
    document.documentElement.dataset.homeMotion = event.matches ? 'reduced' : 'settled';
    revealHomeAbout();
  };
  homeMotionPreference.addEventListener('change', handleHomeMotionPreference);

  window.addEventListener('pagehide', () => {
    window.removeEventListener('scroll', dismissHomeScrollCue);
    homeMotionPreference.removeEventListener('change', handleHomeMotionPreference);
    homeAboutObserver?.disconnect();
  }, { once: true });

  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-tab]'));
  const status = document.querySelector<HTMLElement>('.home-gallery-status');
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[role="tabpanel"][id^="home-gallery-panel-"]'));

  const activateTab = (tab: HTMLButtonElement) => {
    const id = tab.dataset.galleryTab ?? 'all';
    tabs.forEach((item) => {
      const active = item === tab;
      item.setAttribute('aria-selected', String(active));
      item.tabIndex = active ? 0 : -1;
    });
    panels.forEach((panel) => { panel.hidden = panel.id !== `home-gallery-panel-${id}`; });
    const selectedPanel = document.getElementById(`home-gallery-panel-${id}`);
    const heading = selectedPanel?.querySelector('h3')?.textContent;
    status && (status.textContent = id === 'all' ? '目前顯示五個主要面向；選擇分類可查看該主題照片。' : `目前顯示「${heading}」照片。`);
  };

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => activateTab(tab));
    tab.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      const targetIndex = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
      tabs[targetIndex]?.focus();
      tabs[targetIndex] && activateTab(tabs[targetIndex]);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.home-gallery-more').forEach((button) => {
    button.addEventListener('click', () => {
      button.closest('.home-gallery-panel')?.querySelectorAll('.home-photo--extra').forEach((photo) => photo.classList.remove('home-photo--extra'));
      button.remove();
    });
  });

  const lightbox = document.querySelector<HTMLDialogElement>('.home-lightbox');
  const lightboxImage = lightbox?.querySelector('img');
  document.querySelectorAll<HTMLButtonElement>('[data-lightbox-src]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!lightbox || !lightboxImage) return;
      lightboxImage.src = button.dataset.lightboxSrc ?? '';
      lightboxImage.alt = button.querySelector('img')?.alt ?? '照片預覽';
      lightbox.showModal();
    });
  });
  lightbox?.querySelector<HTMLButtonElement>('.home-lightbox__close')?.addEventListener('click', () => lightbox.close());
  lightbox?.addEventListener('click', (event) => { if (event.target === lightbox) lightbox.close(); });

  const form = document.querySelector<HTMLFormElement>('.home-contact__form');
  const formStatus = form?.querySelector<HTMLElement>('.home-contact__status');
  const buildMessage = () => {
    if (!form) return '';
    const data = new FormData(form);
    return `您好，我想洽詢課程：\n姓名：${data.get('name') ?? ''}\n感興趣的內容：${data.get('course') ?? ''}\n目前程度、方便時段或想了解的事情：${data.get('message') ?? ''}`;
  };
  form?.querySelector<HTMLButtonElement>('[data-contact-copy]')?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(buildMessage());
      if (formStatus) formStatus.textContent = '洽詢內容已複製。';
    } catch {
      if (formStatus) formStatus.textContent = '瀏覽器無法複製，請改用 Email 送出。';
    }
  });
  form?.querySelector<HTMLButtonElement>('[data-contact-email]')?.addEventListener('click', () => {
    window.location.href = `mailto:ms@linho.me?subject=${encodeURIComponent('課程洽詢')}&body=${encodeURIComponent(buildMessage())}`;
  });
</script>
