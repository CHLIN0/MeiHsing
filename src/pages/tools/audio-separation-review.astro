---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AudioComparison from '../../components/audio/AudioComparison';
import '../../styles/audio-separation-review.css';

const title = '《明天會更好》伴奏分離｜聆聽比較';
const description = '2026 林美杏老師師生音樂會《明天會更好》伴奏分離的內部比較與驗證頁。';
---

<BaseLayout
  title={title}
  description={description}
  includeReviewSchema={false}
  robots="noindex, nofollow"
>
  <div class="audio-review-page">
    <header class="review-nav">
      <a href="/concert/2026/" aria-label="回到 2026 師生音樂會">
        <span aria-hidden="true">←</span>
        <span>2026 師生音樂會</span>
      </a>
      <span class="review-nav__label">Internal listening room</span>
    </header>

    <main id="main-content">
      <section class="review-hero">
        <div class="review-hero__petals" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
        <div class="review-shell review-hero__inner">
          <p class="review-kicker">Vocal separation study · 2026</p>
          <h1>同一秒，<br /><em>聽見真正的差別。</em></h1>
          <p class="review-hero__lead">
            《明天會更好》去除人聲的完整比較。這裡不只留下最後成品，也保留各模型的伴奏、人聲、殘留檢測與失敗結果。
          </p>
          <div class="review-hero__summary" aria-label="處理摘要">
            <span><strong>5</strong> 組模型路徑</span>
            <span><strong>19</strong> 個可播放音軌</span>
            <span><strong>1</strong> 個推薦成品</span>
          </div>
        </div>
      </section>

      <div class="review-shell review-content">
        <AudioComparison client:load />
      </div>
    </main>

    <footer class="review-footer">
      <div class="review-shell">
        <p>《明天會更好》伴奏分離測試 · 2026 林美杏老師師生音樂會</p>
        <a href="/concert/2026/">回到音樂會主頁</a>
      </div>
    </footer>
  </div>
</BaseLayout>
